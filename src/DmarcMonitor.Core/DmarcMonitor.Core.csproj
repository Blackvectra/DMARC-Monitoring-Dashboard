<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!--
      The client report as a PDF, because the monthly deliverable is emailed
      and an .html attachment is the one thing a mail gateway is most likely
      to strip or warn about. MIT, per the package's own licence expression -
      which is why this rather than QuestPDF, whose community terms carry
      revenue conditions this product would have to answer for.
    -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach two provider helpers that shape what goes over the wire. -->
    <InternalsVisibleTo Include="DmarcMonitor.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      db/schema.sql stays the readable source of truth in the repository; this
      compiles a copy in so a published binary can create a database on a
      machine with no checkout. LogicalName pins the resource name, so moving
      the file does not silently change the lookup in DatabaseSchema.
    -->
    <EmbeddedResource Include="..\..\db\schema.sql" LogicalName="schema.sql" />

    <!--
      Every schema change after the baseline, compiled in for the same reason:
      an upgrade that only works from a source tree is not an upgrade. The
      LogicalName prefix is what DatabaseMigrations looks for, and the number
      in the filename is the order they run in.
    -->
    <EmbeddedResource Include="..\..\db\migrations\*.sql">
      <LogicalName>migration.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!--
      The fonts the PDF is drawn with, compiled in for the same reason as the
      schema: a container has no fonts installed, and PDFsharp on anything but
      Windows has no system fonts to fall back on. Without these a client
      report renders on a laptop and throws on the server that is supposed to
      produce it every month.

      Liberation Sans, under the SIL Open Font License 1.1, whose text ships
      beside them. Regular and bold only - nothing here is set in italic, and
      each face is 400 KB.
    -->
    <EmbeddedResource Include="Fonts\*.ttf">
      <LogicalName>font.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fonts\LICENSE-Liberation.txt" LogicalName="font.LICENSE.txt" />
  </ItemGroup>

</Project>
