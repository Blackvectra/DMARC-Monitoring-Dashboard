{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Path": "dmarc.db"
  },

  "Reporting": {
    "ProviderName": "",

    // Where TLS-RPT reports should be sent. Set it and the Fix page will
    // offer to publish the record; leave it empty and it will not, because a
    // record pointing at a mailbox nobody reads is worse than none.
    "TlsReportAddress": ""
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc"
  },

  "Auth": {
    "AllowLocalModeRemotely": false
  },

  "Secrets": {
    "Directory": ""
  },

  // Whether this instance checks what has been released.
  //
  // Off unless a repository is named. When on, it asks GitHub for the list of
  // releases and compares the newest against what is running - one outbound
  // request, carrying nothing about this instance or its customers. It never
  // downloads or installs anything; updating is deploy/update.sh, run by a
  // person who decided to.
  //
  // Channel is "stable" (released versions only) or "preview" (release
  // candidates too). Token is needed only for a private repository.
  "Updates": {
    "Repository": "",
    "Channel": "stable",
    "Token": ""
  },

  // Where this instance is reachable from the internet. Each client's
  // mta-sts.<domain> is a CNAME pointing here, and a sender fetches the
  // policy over HTTPS, so the certificate has to be valid for THAT name.
  // Without this the Fix page cannot tell anybody what to point the CNAME at.
  "MtaSts": {
    "PolicyHost": ""
  },

  "Proxy": {
    "Behind": false,
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
