@page "/domains/{Domain}"
@using DmarcMonitor.Core.Dns
@using DmarcMonitor.Core.Rollout
@using DmarcMonitor.Core.Domains
@using DmarcMonitor.Web.Data
@inject DomainDetailService Detail
@inject DnsLookup Dns
@inject ReportStoreConnection Db
@rendermode InteractiveServer

<PageTitle>@Domain — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <p class="crumb"><a href="">Triage</a> / @Domain</p>
        <h1>@Domain</h1>
        @if (_detail is not null)
        {
            <p class="sub">@_detail.ClientName</p>
        }
    </div>
    <div class="head-actions">
        <label>
            Window
            <select @bind="_days" @bind:after="LoadAsync">
                <option value="7">7 days</option>
                <option value="30">30 days</option>
                <option value="90">90 days</option>
            </select>
        </label>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been ingested.</p>
    </div>
}
else if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else if (_detail is null)
{
    @* Not an error page. A domain nobody has reported on yet is a normal
       state during onboarding, and the useful thing is to say what would
       make it appear. *@
    <div class="empty">
        <h2>Nothing stored for @Domain</h2>
        <p>No reports have been received for this domain, so there is nothing to show yet.</p>
        <p class="muted">
            Either the DMARC record has no <code>rua</code> address pointing here, or it was published
            too recently for the first reports to arrive. Receivers send daily.
        </p>
    </div>
}
else
{
    <section class="callout @Css(_detail.Level)">
        <h2>@(string.IsNullOrEmpty(_detail.Headline) ? "Nothing needs doing." : _detail.Headline)</h2>
        <p>@Explain(_detail)</p>
    </section>

    <div class="figures">
        <div class="figure">
            <span class="figure-n">@_detail.Messages.ToString("N0")</span>
            <span class="figure-l">messages</span>
        </div>
        <div class="figure">
            <span class="figure-n @(_detail.Messages > 0 && _detail.PassRate < 95 ? "bad" : "good")">
                @(_detail.Messages > 0 ? $"{_detail.PassRate}%" : "—")
            </span>
            <span class="figure-l">authenticated</span>
        </div>
        <div class="figure">
            <span class="figure-n">p=@_detail.Policy</span>
            <span class="figure-l">
                @if (_detail.Pct < 100)
                {
                    @* pct applies the policy to a SAMPLE. A domain at p=reject
                       with pct=20 is not rejecting four fifths of its failures,
                       and reading the policy alone would say otherwise. *@
                    <span>on @_detail.Pct% of mail</span>
                }
                else
                {
                    <span>policy</span>
                }
            </span>
        </div>
        <div class="figure">
            <span class="figure-n">@_detail.Sources.Count</span>
            <span class="figure-l">sending sources</span>
        </div>
    </div>

    @if (_detail.Impersonating.Count > 0)
    {
        <section>
            <h2>Sending as @Domain without authenticating</h2>
            <p class="sub">Proved nothing when they failed. Either a service nobody recorded, or somebody
               sending as this domain.</p>
            <table class="triage">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="num">Sent</th>
                        <th class="num">Failed</th>
                        <th class="num">Other clients</th>
                        <th>Last seen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _detail.Impersonating)
                    {
                        <tr class="@(s.OtherClients > 0 ? "urgent" : "act")">
                            <td><code>@s.SourceIp</code></td>
                            <td class="num">@s.Messages.ToString("N0")</td>
                            <td class="num">@s.Failing.ToString("N0")</td>
                            <td class="num">
                                @if (s.OtherClients > 0)
                                {
                                    <strong class="bad">@s.OtherClients</strong>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td class="muted">@Ago(s.LastSeen)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (_detail.SigningUnaligned.Count > 0)
    {
        @* The line an operator misreads, every time. "dkim=pass" and
           "dmarc=fail" on the same row is not a contradiction: the signature
           verified, over a domain DMARC does not accept for this mail. Somebody
           who has already set DKIM up with the vendor reads the failure as the
           product being wrong, and stops looking. *@
        <section class="callout act">
            <h2>
                @(_detail.SigningUnaligned.Count == 1
                    ? "A source is signing correctly for the wrong domain"
                    : $"{_detail.SigningUnaligned.Count} sources are signing correctly for the wrong domain")
            </h2>
            <p>
                DKIM is working on @(_detail.SigningUnaligned.Count == 1 ? "this source" : "these sources") —
                the signature@(_detail.SigningUnaligned.Count == 1 ? "" : "s") verified. DMARC threw it away
                anyway, because it also requires the signing domain to match the one in the From header, and
                @(_detail.SigningUnaligned.Count == 1 ? "it does" : "they do") not.
                @if (_detail.Policy is "reject" or "quarantine")
                {
                    <strong> At p=@_detail.Policy that mail is being lost right now.</strong>
                }
            </p>

            <table class="triage">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="num">Failed</th>
                        <th>Signs as</th>
                        <th>Why it does not count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _detail.SigningUnaligned)
                    {
                        @* One source, however many domains it signs. Repeating
                           the failure count against each of them reads as that
                           many separate losses - one address on the live data
                           signs three Mailchimp domains and would have claimed
                           223 failures three times over. *@
                        @foreach (var (u, i) in s.UnalignedDkim.Select((u, i) => (u, i)))
                        {
                            <tr class="act">
                                @if (i == 0)
                                {
                                    <td rowspan="@s.UnalignedDkim.Count"><code>@s.SourceIp</code></td>
                                    <td class="num" rowspan="@s.UnalignedDkim.Count">@s.Failing.ToString("N0")</td>
                                }
                                <td><code>d=@u.Domain</code></td>
                                <td>
                                    @if (u.WouldAlignIfRelaxed)
                                    {
                                        <span>A subdomain of @Domain. You publish <code>adkim=s</code>,
                                              which requires an exact match.</span>
                                    }
                                    else if (u.Verdict == AlignmentVerdict.Organizational)
                                    {
                                        <span>A subdomain of @Domain, which should align. If it is still
                                              failing, the signature is being broken after signing.</span>
                                    }
                                    else
                                    {
                                        <span>A different organisation from @Domain. No alignment setting
                                              makes this count.</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <p><strong>What fixes it</strong></p>
            <ul>
                @if (_detail.SigningUnaligned.Any(s => s.UnalignedDkim.Any(u => u.Verdict == AlignmentVerdict.Unrelated)))
                {
                    <li>
                        Have the service sign as <code>@Domain</code> rather than as itself. Most senders
                        call this custom, branded or authenticated DKIM, and it is usually configured
                        <em>per product</em> — turning it on for one kind of mail leaves the others signing
                        the vendor's own domain.
                    </li>
                }
                @if (_detail.AnyWouldAlignIfRelaxed)
                {
                    <li>
                        Or change <code>adkim=s</code> to <code>adkim=r</code> on @Domain, which accepts a
                        signature from a subdomain. Only worth doing once you have confirmed the subdomain
                        is yours — relaxing alignment widens what counts as authentic.
                    </li>
                }
            </ul>

            @{
                // Grouped by the host doing it right. Two broken addresses of
                // one vendor are one fact about that vendor, and saying it
                // twice makes it read as two separate discoveries.
                var proven = _detail.SigningUnaligned
                    .Where(s => s.SameServiceSigningCorrectly is not null)
                    .GroupBy(s => s.SameServiceSigningCorrectly!, StringComparer.Ordinal)
                    .ToList();
            }
            @foreach (var group in proven)
            {
                @* The fact that ends the argument with a vendor. Its own other
                   sending host already signs as this customer, so "we cannot do
                   that" is not available. *@
                <p>
                    The same service also sends this domain's mail from <code>@group.Key</code>, and
                    <strong>that path signs as @Domain correctly</strong> — so the capability exists on
                    this account.
                    @(group.Count() == 1 ? "This source has" : "These sources have") simply not been
                    switched over:
                    @foreach (var (s, i) in group.Select((s, i) => (s, i)))
                    {
                        @(i > 0 ? ", " : "")<code>@s.SourceIp</code>
                    }.
                </p>
            }
        </section>
    }

    @if (_detail.Misconfigured.Count > 0)
    {
        <section>
            <h2>This domain's own mail, failing</h2>
            <p class="sub">Real services, signing as themselves rather than as @Domain. This is mail
               being lost, and it is the work to do before enforcing.</p>
            <table class="triage">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="num">Sent</th>
                        <th class="num">Failed</th>
                        <th>Signs as</th>
                        <th>Last seen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _detail.Misconfigured)
                    {
                        <tr class="act">
                            <td><code>@s.SourceIp</code></td>
                            <td class="num">@s.Messages.ToString("N0")</td>
                            <td class="num">@s.Failing.ToString("N0")</td>
                            <td>
                                <code>@s.AuthenticatedFor</code>
                                @if (s.UnalignedDkim.Count > 0)
                                {
                                    @* So the two sections are visibly about the
                                       same rows, rather than reading as two
                                       separate problems on one address. *@
                                    <span class="muted"> — DKIM valid, not aligned</span>
                                }
                            </td>
                            <td class="muted">@Ago(s.LastSeen)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (_detail.Clean.Count > 0)
    {
        <section>
            <h2>Authenticating cleanly</h2>
            <table class="triage">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="num">Messages</th>
                        <th>Last seen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _detail.Clean.Take(_showAllClean ? int.MaxValue : 10))
                    {
                        <tr class="fine">
                            <td><code>@s.SourceIp</code></td>
                            <td class="num">@s.Messages.ToString("N0")</td>
                            <td class="muted">@Ago(s.LastSeen)</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_detail.Clean.Count > 10 && !_showAllClean)
            {
                <p><button class="linkish" @onclick="() => _showAllClean = true">
                    Show the other @(_detail.Clean.Count - 10)
                </button></p>
            }
        </section>
    }

    @if (_detail.OverriddenMessages > 0)
    {
        @* The source tables above sum to less than the headline, because
           forwarded and receiver-overridden traffic is left out of them on
           purpose. Unexplained that gap reads as arithmetic going wrong. *@
        <p class="sub">
            The tables above leave out @_detail.OverriddenMessages.ToString("N0") message(s) the receiving
            provider overrode - forwarded mail, or its own local policy. Those are counted in the
            @_detail.Messages.ToString("N0") above but are not a sending source worth acting on.
        </p>
    }

    <section>
        <h2>What is published right now</h2>
        <p class="sub">Everything above comes from reports, and the newest of those is
           @Ago(_detail.LastReport). This is DNS, read just now.</p>

        @if (_dnsPending)
        {
            <p class="muted">Reading DNS…</p>
        }
        else if (_dns is null || _dns.LookupFailed)
        {
            @* Not "no record". A resolver that failed proves nothing, and
               saying otherwise sends somebody to publish a second record over
               a working first. *@
            <p class="muted">Could not read DNS for this domain just now, so nothing here is known.</p>
        }
        else
        {
            var published = DmarcRecord.Parse(_dns.DmarcRecord);

            @if (!published.IsValid)
            {
                <section class="callout act">
                    <h2>No DMARC record is published</h2>
                    <p>Reports arrived for this domain, so one existed when they were sent. Either it has
                       been removed or it is no longer readable.</p>
                </section>
            }
            else
            {
                @* The reason this section exists. For a domain that has gone
                   quiet the reported policy is stale by definition, and that
                   is exactly when somebody asks whether their change landed. *@
                @if (!string.Equals(published.Policy, _detail.Policy, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="callout act">
                        <h2>DNS says p=@published.Policy, the reports say p=@_detail.Policy</h2>
                        <p>
                            The record has been changed since the last report arrived
                            @Ago(_detail.LastReport). DNS is the truth; everything above still describes
                            @_detail.Policy, because that is what was in force when the mail it counts was
                            sent. The figures catch up as new reports arrive.
                        </p>
                    </section>
                }

                <table class="triage">
                    <tbody>
                        <tr>
                            <td>Policy</td>
                            <td><code>p=@published.Policy</code></td>
                        </tr>
                        <tr>
                            <td>Subdomains</td>
                            <td>
                                @if (published.SubdomainPolicy.Length == 0)
                                {
                                    <span><code>sp</code> not set, so subdomains inherit
                                          <code>p=@published.Policy</code></span>
                                }
                                else if (Weaker(published.SubdomainPolicy, published.Policy))
                                {
                                    <span class="bad"><code>sp=@published.SubdomainPolicy</code> — weaker than the
                                          domain itself, so mail from a subdomain is treated more leniently</span>
                                }
                                else
                                {
                                    <span><code>sp=@published.SubdomainPolicy</code></span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Applied to</td>
                            <td>
                                @if (published.Percent < 100)
                                {
                                    <span class="bad">@published.Percent% of failing mail — the rest is
                                          delivered whatever the policy says</span>
                                }
                                else
                                {
                                    <span>all failing mail</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Alignment</td>
                            <td>
                                @if (published.StrictDkim || published.StrictSpf)
                                {
                                    @* Called out because it is invisible until
                                       it costs somebody a sending path, and the
                                       report row it produces reads as a broken
                                       key rather than as this setting. *@
                                    <span>
                                        <code>adkim=@(published.StrictDkim ? "s" : "r")</code>
                                        <code>aspf=@(published.StrictSpf ? "s" : "r")</code>
                                        — strict, so a signature or envelope from a
                                        <em>subdomain</em> of @Domain does not count
                                    </span>
                                }
                                else
                                {
                                    <span>relaxed, so a subdomain of @Domain counts</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Reports to</td>
                            <td>
                                @if (published.Rua.Length == 0)
                                {
                                    <span class="bad">nobody — no <code>rua</code>, so this page stops
                                          updating</span>
                                }
                                else
                                {
                                    <code>@published.Rua</code>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Record</td>
                            <td><code class="wrap">@published.Raw</code></td>
                        </tr>
                        @if (_dns.SpfRecords.Count > 0)
                        {
                            <tr>
                                <td>SPF</td>
                                <td>
                                    <code class="wrap">@_dns.SpfRecords[0]</code>
                                    <span class="muted"> — @_dns.SpfLookups of
                                          @DnsHygiene.SpfLookupLimit DNS lookups</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </section>

    <section>
        <h2>Who is reporting</h2>
        <p class="sub">A clean pass rate heard from one receiver is a partial picture, not a verdict.</p>

        @{ var quiet = _detail.Reporters.Where(r => r.HasGoneQuiet).ToList(); }
        @if (quiet.Count > 0)
        {
            @* The dangerous shape. A domain nobody reports on is already
               flagged; this is the one where reports keep arriving and the
               pass rate quietly becomes "whoever is left". *@
            <div class="callout urgent">
                <h3>@(quiet.Count == 1 ? "A receiver that carried this domain's mail has stopped reporting"
                                        : $"{quiet.Count} receivers that carried this domain's mail have stopped reporting")</h3>
                <p>
                    @foreach (var r in quiet)
                    {
                        <span><strong>@r.OrgName</strong> reported @r.Share.ToString("0.#")% of this domain's
                        mail and last sent anything @Ago(r.LastReport).</span><br />
                    }
                </p>
                <p>
                    The figures above are computed from the receivers still reporting, so they describe less
                    of this domain's mail than they appear to. Worth settling before advancing the policy:
                    either that mail stopped flowing, the <code>rua</code> address changed, or the reports
                    are arriving and not reaching this database.
                </p>
            </div>
        }

        @if (_detail.Reporters.Count == 0)
        {
            <p class="muted">No reports at all for this domain.</p>
        }
        else
        {
            <table class="triage">
                <thead>
                    <tr><th>Receiver</th><th class="num">Reports</th><th class="num">Share</th><th>Last</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in _detail.Reporters)
                    {
                        <tr class="@(r.HasGoneQuiet ? "warn" : "")">
                            <td>
                                @r.OrgName
                                @if (r.HasGoneQuiet) { <span class="bad"> — stopped</span> }
                            </td>
                            <td class="num">@r.Reports</td>
                            <td class="num">@r.Share.ToString("0.#")%</td>
                            <td class="muted">@Ago(r.LastReport)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="sub">Share is of every message ever reported for this domain, and the list is the whole
               history rather than the window: a receiver that stopped before the window began would not
               appear in it at all, which is exactly the case worth seeing.</p>
        }
    </section>
}

@code {
    [Parameter] public string Domain { get; set; } = "";

    private DomainDetail? _detail;
    private PublishedRecords? _dns;

    // Starts true, because before anything has been attempted the honest
    // state is "not yet", not "failed". A page rendered before its circuit
    // connects would otherwise claim DNS could not be read when nothing had
    // tried - the same confusion between absence and failure that the lookup
    // itself is careful to avoid.
    private bool _dnsPending = true;
    private string? _error;
    private bool _loading = true;
    private bool _showAllClean;
    private int _days = 30;

    protected override Task OnParametersSetAsync() => LoadAsync();

    /// <summary>
    /// Reads DNS after the page has already rendered.
    /// </summary>
    /// <remarks>
    /// The only thing on this page that leaves the machine. Doing it during
    /// the first render would hold the whole page behind a resolver that can
    /// take seconds and sometimes never answers, so the reports appear
    /// immediately and this section fills itself in.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _detail is null || _dns is not null) { return; }

        try
        {
            _dns = await Dns.ReadAsync(_detail.Domain);
        }
        catch (Exception)
        {
            // Rendered as "could not read", never as "no record". The two mean
            // opposite things to somebody about to edit a customer's DNS.
            _dns = new PublishedRecords { Domain = _detail.Domain, LookupFailed = true };
        }
        finally
        {
            _dnsPending = false;
            StateHasChanged();
        }
    }

    /// <summary>True when a subdomain policy is more lenient than the domain's own.</summary>
    private static bool Weaker(string sp, string p) => Strength(sp) < Strength(p);

    private static int Strength(string policy) => policy.ToLowerInvariant() switch
    {
        "reject" => 3,
        "quarantine" => 2,
        "none" => 1,
        _ => 0,
    };

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        // Cleared so navigating between domains does not show the previous
        // domain's record beside this one's reports.
        _dns = null;
        _dnsPending = true;

        if (!Db.Exists) { _loading = false; return; }

        try
        {
            _detail = await Detail.GetAsync(Domain, _days);
        }
        catch (Exception ex)
        {
            // Rendering an empty page for a broken database would read as
            // "this domain is quiet", which is the opposite of the truth.
            _detail = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// The sentence under the headline: what the current policy actually does
    /// to failing mail, rather than restating the policy string.
    /// </summary>
    private static string Explain(DomainDetail d)
    {
        var failing = d.Failing;

        var effect = d.Policy switch
        {
            "reject" => $"Mail failing authentication is refused outright{Sample(d)}.",
            "quarantine" => $"Mail failing authentication is sent to junk{Sample(d)}.",
            _ => "Nothing is being blocked: at p=none a receiver delivers failing mail as normal and "
               + "only reports on it.",
        };

        if (failing == 0)
        {
            return effect + " Nothing failed in this window.";
        }

        return effect + $" {failing:N0} message(s) failed here, from "
             + $"{d.Impersonating.Count} unauthenticated source(s) and {d.Misconfigured.Count} "
             + "service(s) signing as themselves.";
    }

    /// <summary>
    /// pct is the tag operators forget. A domain at p=reject with pct=20 looks
    /// enforcing everywhere it is summarised, and is not.
    /// </summary>
    private static string Sample(DomainDetail d) =>
        d.Pct < 100 ? $", but only for {d.Pct}% of it - the rest is delivered" : "";

    private static string Ago(DateTimeOffset? when)
    {
        if (when is null) { return "—"; }

        var days = (int)(DateTimeOffset.UtcNow - when.Value).TotalDays;
        return days switch
        {
            <= 0 => "today",
            1 => "yesterday",
            _ => $"{days} days ago",
        };
    }

    private static string Css(TriageLevel level) => level switch
    {
        TriageLevel.Urgent => "urgent",
        TriageLevel.Act => "act",
        TriageLevel.Watch => "watch",
        TriageLevel.OnTrack => "ontrack",
        _ => "fine",
    };
}
