@page "/import"
@using DmarcMonitor.Core.Ingest
@using DmarcMonitor.Core.Tenancy
@using DmarcMonitor.Web.Auth
@using DmarcMonitor.Web.Data
@inject ImportUiService Importer
@inject ReportStoreConnection Db
@inject OrgContext Org
@inject AuditLog Audit
@rendermode InteractiveServer

<PageTitle>Import — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Import reports</h1>
        <p class="sub">Drop in whatever you have: a single report somebody forwarded, or a whole
           mailbox export. Zipped, gzipped or bare, and zips of zips, which is what an export
           usually is. Importing the same thing twice is safe — reports already stored are
           recognised and skipped.</p>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Create it first, then come back:</p>
        <pre>dmarc init-db --db @Db.Path</pre>
    </div>
}
else if (_access is { CanOperate: false })
{
    <div class="empty">
        <h2>Importing needs the operator role</h2>
        <p>You can read everything in @(_access.Current?.Name ?? "this organisation"), but bringing reports in
           changes it. Ask an admin to add you to the operator group.</p>
    </div>
}
else
{
    @if (_access is not null)
    {
        @* Said before anything is dropped: a report for a domain nobody has
           seen creates that domain, and which organisation it lands in is
           decided here, not discovered on the Clients page afterwards. *@
        <p class="sub">
            Domains not seen before are filed under
            <strong>@(_access.Current?.Name ?? _access.Visible.FirstOrDefault(o => o.Slug == OrgContext.OrganisationFor(_access))?.Name ?? OrgContext.OrganisationFor(_access))</strong>@(_access is { IsMaster: true, Current: null, Visible.Count: > 1 } ? " — switch organisation in the sidebar to file them elsewhere." : ".")
            Domains already known keep their client and organisation.
        </p>
    }

    <section>
        @* The file input sits invisibly over the whole panel, so dropping and
           clicking both work with no script of our own: a file input accepts
           dropped files natively. *@
        <div class="dropzone @(_over ? "over" : "") @(_running ? "busy" : "")"
             @ondragenter="() => _over = true"
             @ondragleave="() => _over = false"
             @ondrop="() => _over = false">

            @if (!_running)
            {
                <InputFile class="dropzone-input" multiple OnChange="UploadAsync" />
            }

            <div class="dropzone-face">
                @if (_running)
                {
                    <strong>Importing…</strong>
                    <span>@(_filesRead > 0 ? $"{_filesRead:N0} file(s) read so far" : "reading")</span>
                }
                else
                {
                    <strong>Drop report files here</strong>
                    <span>or click to choose them</span>
                }
            </div>
        </div>

        @if (_running)
        {
            <div class="form-row">
                <button class="linkish" @onclick="Cancel">Stop</button>
            </div>
        }
    </section>

    @if (_problem is not null)
    {
        <section class="callout urgent">
            <h2>@_problem</h2>
        </section>
    }

    @if (_result is not null)
    {
        <section class="callout @(_result.Stored > 0 ? "fine" : "watch")">
            <h2>@Summary(_result)</h2>
            @if (_result.StoppedEarly)
            {
                <p>Stopped before the end. Everything read so far is stored; run it again to carry on
                   from where it left off.</p>
            }
        </section>

        <div class="figures">
            <div class="figure">
                <span class="figure-n">@_result.FilesSeen.ToString("N0")</span>
                <span class="figure-l">files read</span>
            </div>
            <div class="figure">
                <span class="figure-n good">@_result.Stored.ToString("N0")</span>
                <span class="figure-l">reports stored</span>
            </div>
            <div class="figure">
                <span class="figure-n">@_result.AlreadyStored.ToString("N0")</span>
                <span class="figure-l">already had</span>
            </div>
            <div class="figure">
                <span class="figure-n">@_result.NotReports.ToString("N0")</span>
                <span class="figure-l">not reports</span>
            </div>
            @if (_result.Failed > 0)
            {
                <div class="figure">
                    <span class="figure-n bad">@_result.Failed.ToString("N0")</span>
                    <span class="figure-l">failed</span>
                </div>
            }
        </div>

        @if (_result.Errors.Count > 0)
        {
            <section>
                <h2>What failed</h2>
                <ul class="errors">
                    @foreach (var error in _result.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
                @if (_result.Failed > _result.Errors.Count)
                {
                    <p class="sub">and @(_result.Failed - _result.Errors.Count) more.</p>
                }
            </section>
        }

        @if (_unassigned.Count > 0)
        {
            <section class="callout act">
                <h2>@_unassigned.Count domain(s) are not assigned to a client</h2>
                <p>They will not appear on anybody's report until they are.
                   <a href="clients">Assign them now</a>.</p>
            </section>
        }
    }

    <section>
        <h2>Or import a folder on the server</h2>
        <p class="sub">For an export that already lives on this machine, or one too big to upload.
           The folder is read by the service, not from your computer, so it has to be a path this
           server can see. Subfolders are included.</p>
        <div class="form-row">
            <input class="wide" placeholder="C:\dmarc-export" @bind="_folder" @bind:event="oninput"
                   disabled="@_running" />
            <button class="primary" disabled="@(_running || string.IsNullOrWhiteSpace(_folder))"
                    @onclick="ImportFolderAsync">
                Import folder
            </button>
        </div>
    </section>
}

@code {
    private string _folder = "";
    private bool _running;
    private bool _over;
    private int _filesRead;
    private ImportResult? _result;
    private string? _problem;
    private IReadOnlyList<string> _unassigned = [];
    private CancellationTokenSource? _cts;
    private OrganisationAccess? _access;

    protected override async Task OnInitializedAsync()
    {
        if (!Db.Exists) { return; }
        try { _access = await Org.GetAsync(); }
        catch (Exception) { _access = null; }
    }

    private string Organisation => _access is null
        ? DmarcMonitor.Core.Storage.ReportStore.DefaultTenantSlug
        : OrgContext.OrganisationFor(_access);

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(ImportUiService.MaxFiles);
        }
        catch (InvalidOperationException)
        {
            // Thrown when the drop holds more than the cap. Said as a number
            // and a way forward, not as the framework's own wording.
            _problem = $"That is more than {ImportUiService.MaxFiles:N0} files at once. "
                     + "Drop them in batches, or put the folder on the server and import it below.";
            return;
        }

        if (files.Count == 0) { return; }

        await RunAsync(
            (progress, ct) => Importer.ImportUploadsAsync(files, Organisation, progress, ct));
    }

    private async Task ImportFolderAsync()
    {
        var folder = _folder.Trim();
        if (folder.Length == 0) { return; }

        if (!Directory.Exists(folder))
        {
            // Named plainly rather than as an exception: a path typed for the
            // wrong machine is the most likely mistake on this page.
            _problem = $"There is no folder at {folder} on the machine running this service.";
            _result = null;
            return;
        }

        await RunAsync((progress, ct) => Importer.ImportAsync(folder, Organisation, progress, ct));
    }

    private async Task RunAsync(Func<IProgress<int>, CancellationToken, Task<ImportResult>> import)
    {
        // The handler runs on the server; a hidden panel is not a permission.
        if (_access is not { CanOperate: true }) { return; }

        _problem = null;
        _result = null;
        _filesRead = 0;
        _running = true;
        _cts = new CancellationTokenSource();

        try
        {
            var progress = new Progress<int>(n =>
            {
                _filesRead = n;
                InvokeAsync(StateHasChanged);
            });

            _result = await import(progress, _cts.Token);
            _unassigned = await Importer.GetUnassignedDomainsAsync(_access?.TenantId);
            if (_result.Stored > 0)
            {
                await Audit.RecordAsync(_access?.Current?.Id, _access?.User ?? "", "reports.imported",
                    $"{_result.Stored} report(s) stored under {Organisation}");
            }
        }
        catch (OperationCanceledException)
        {
            // Stopping is a choice somebody made, not a failure.
        }
        catch (Exception ex)
        {
            _problem = ex.Message;
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void Cancel() => _cts?.Cancel();

    private static string Summary(ImportResult r)
    {
        if (r.Stored == 0 && r.AlreadyStored > 0)
        {
            return $"Nothing new: all {r.AlreadyStored:N0} report(s) were already stored.";
        }

        if (r.Stored == 0)
        {
            return r.FilesSeen == 0
                ? "Nothing there to read."
                : "No reports found. Those files are not DMARC or TLS reports this can read.";
        }

        return r.AlreadyStored > 0
            ? $"Stored {r.Stored:N0} report(s), and recognised {r.AlreadyStored:N0} already held."
            : $"Stored {r.Stored:N0} report(s).";
    }
}
