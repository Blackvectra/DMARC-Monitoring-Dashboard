@page "/settings"
@layout DmarcMonitor.Web.Components.Layout.ProviderLayout
@using DmarcMonitor.Web.Auth
@using DmarcMonitor.Web.Data
@inject IConfiguration Configuration
@inject ReportStoreConnection Db
@inject ReportUiService ReportUi
@inject RemediationUiService Fixes
@inject OnboardingService Onboarding
@inject DmarcMonitor.Core.Updates.ReleaseChannel Releases
@inject OrgContext Org
@inject DmarcMonitor.Core.Tenancy.OrganizationStore Organizations
@inject DmarcMonitor.Core.Tenancy.AuditLog Audit
@inject DmarcMonitor.Core.Storage.RetentionPolicy Retention
@rendermode InteractiveServer

<PageTitle>Settings — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Settings</h1>
        <p class="sub">What this instance is actually configured to do. Read-only: these come from
           appsettings.json and the environment, so changing them here would be a second source of
           truth that disagrees with the file after the next restart.</p>
    </div>
</header>

@if (!EntraConfigured)
{
    @* The one thing on this page worth interrupting somebody for. *@
    <section class="callout @(LocalModeRemote ? "urgent" : "act")">
        <h2>@(LocalModeRemote ? "Serving every address with no sign-in" : "No sign-in (local trial mode)")</h2>
        <p>
            @if (LocalModeRemote)
            {
                <span>
                    <code>Auth:AllowLocalModeRemotely</code> is set, so anyone who can reach this port can
                    read every customer's mail data. Turn it off, or configure Microsoft sign-in, before
                    this is reachable from anywhere but this machine.
                </span>
            }
            else
            {
                <span>
                    Only this machine can reach it. That is fine for a trial and not fine for a shared
                    install: configure <code>AzureAd</code> to turn on Microsoft sign-in.
                </span>
            }
        </p>
    </section>
}

<section>
    <h2>Sign-in</h2>
    <table class="triage">
        <tbody>
            <tr>
                <td>Method</td>
                <td>@(EntraConfigured ? "Microsoft Entra" : "None (local trial mode)")</td>
            </tr>
            @if (EntraConfigured)
            {
                <tr><td>Tenant</td><td><code>@Show("AzureAd:TenantId")</code></td></tr>
                <tr><td>Application</td><td><code>@Show("AzureAd:ClientId")</code></td></tr>
            }
            else
            {
                <tr>
                    <td>Reachable from</td>
                    <td>@(LocalModeRemote ? "any address" : "this machine only")</td>
                </tr>
            }
            <tr>
                <td>Signed in as</td>
                <td>
                    <AuthorizeView>
                        <Authorized>@context.User.Identity?.Name</Authorized>
                        <NotAuthorized><span class="muted">nobody</span></NotAuthorized>
                    </AuthorizeView>
                </td>
            </tr>
            <tr>
                <td>Master group</td>
                <td>
                    @if (Configuration[OrgContext.MasterGroupKey] is { Length: > 0 } master)
                    {
                        <code>@master</code>
                        <span class="muted"> — members see every organization</span>
                    }
                    else
                    {
                        <span class="muted">not set. Set <code>@OrgContext.MasterGroupKey</code> to the object id of the
                            Entra group whose members may see every organization.</span>
                    }
                </td>
            </tr>
            @if (_access is not null)
            {
                <tr>
                    <td>Your access</td>
                    <td>
                        @if (_access.IsMaster)
                        {
                            <span>every organization (@(EntraConfigured ? "master group" : "no sign-in, so the machine is the boundary"))</span>
                        }
                        else if (_access.Visible.Count > 0)
                        {
                            <span>@string.Join(", ", _access.Visible.Select(o => $"{o.Name} ({_access.Roles.GetValueOrDefault(o.Slug).ToString().ToLowerInvariant()}{(_access.ClientRestrictions.TryGetValue(o.Slug, out var only) ? $", {only} only" : "")})"))</span>
                        }
                        else
                        {
                            <span class="bad">none — you are in no organization's group</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section>
    <h2>Organizations</h2>
    <p class="sub">The layer above clients. Each organization has its own clients and domains, and the people
       in its Entra security groups see those and nothing else: admins run its settings, engineers raise
       DMARC policies, techs assign domains and repair SPF and DKIM, viewers read. Setting a group here
       does nothing until the app registration's token configuration includes the <code>groups</code>
       claim.</p>

    @if (_organizations is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <table class="triage">
            <thead>
                <tr><th>Organization</th><th>Slug</th><th>Groups</th><th class="num">Clients</th><th class="num">Domains</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var o in _organizations)
                {
                    <tr>
                        <td>
                            @if (o.Brand.Logo is { } logo && DmarcMonitor.Core.Tenancy.OrganizationBrand.IsValidLogo(logo))
                            {
                                <img src="@logo" alt="" style="max-height:20px;max-width:80px;vertical-align:middle;margin-right:6px" />
                            }
                            @o.Name
                            @if (o.Brand.PrimaryColor is { } c && DmarcMonitor.Core.Tenancy.OrganizationBrand.IsValidColor(c))
                            {
                                <span class="pip" style="background:@c;margin-left:6px" title="@c"></span>
                            }
                        </td>
                        <td><code>@o.Slug</code></td>
                        <td class="muted">
                            @(o.AdminGroupId is { Length: > 0 } ? "admin " : "")@(o.EngineerGroupId is { Length: > 0 } ? "engineer " : "")@(o.EntraGroupId is { Length: > 0 } ? "tech " : "")@(o.ViewerGroupId is { Length: > 0 } ? "viewer" : "")
                            @if (o.AdminGroupId is null && o.EngineerGroupId is null && o.EntraGroupId is null && o.ViewerGroupId is null)
                            {
                                <span>none — only the master group sees it</span>
                            }
                        </td>
                        <td class="num">@o.Clients</td>
                        <td class="num">@o.Domains</td>
                        <td>
                            @if (CanEdit(o))
                            {
                                <button disabled="@_busy" @onclick="() => BeginEdit(o)">@(_editSlug == o.Slug ? "Editing" : "Edit")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_organizationMessage is not null)
        {
            <p class="@(_organizationMessageIsError ? "bad" : "good")">@_organizationMessage</p>
        }

        @if (_editSlug.Length > 0)
        {
            <h3>@_editName</h3>
            <p class="sub">Groups are Entra security group object ids. The strongest group a person is in wins.</p>
            <div class="form-row">
                <input placeholder="Name" @bind="_editName" @bind:event="oninput" aria-label="Name" />
            </div>
            <div class="form-row">
                <input placeholder="Admin group object id" @bind="_editAdmin" @bind:event="oninput" aria-label="Admin group" />
                <input placeholder="Engineer group object id" @bind="_editEngineer" @bind:event="oninput" aria-label="Engineer group" />
                <input placeholder="Tech group object id" @bind="_editOperator" @bind:event="oninput" aria-label="Tech group" />
                <input placeholder="Viewer group object id" @bind="_editViewer" @bind:event="oninput" aria-label="Viewer group" />
            </div>
            <p class="sub">Techs do the daily work and repair SPF and DKIM. Engineers may also raise a
               DMARC policy from <code>p=none</code> to quarantine to reject — the one change that can
               stop real mail being delivered. Leave the engineer group empty and nobody below admin
               can raise a policy.</p>
            <p class="sub">White-label: the sidebar takes the color and logo, and this organization's reports say
               "prepared by" the provider name and end with the contact block.</p>
            <div class="form-row">
                <input placeholder="Accent color, e.g. #4f46e5" @bind="_editColor" @bind:event="oninput" aria-label="Accent color" />
                <input placeholder="Provider name on reports" @bind="_editProvider" @bind:event="oninput" aria-label="Provider name" />
            </div>
            <div class="form-row">
                <textarea class="wide" rows="3" placeholder="Contact block for the report footer, one line per line"
                          @bind="_editContact" @bind:event="oninput" aria-label="Contact block"></textarea>
            </div>
            <div class="form-row">
                <label class="toggle">
                    Logo (PNG, JPEG, SVG, up to @(DmarcMonitor.Core.Tenancy.OrganizationBrand.MaxLogoLength / 1000) KB)
                    <InputFile OnChange="OnLogoAsync" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" />
                </label>
                @if (_editLogo is not null)
                {
                    <img src="@_editLogo" alt="logo" style="max-height:36px" />
                    <button @onclick="() => _editLogo = null">Remove logo</button>
                }
                @if (_editLogoProblem is not null)
                {
                    <span class="bad">@_editLogoProblem</span>
                }
            </div>
            <div class="form-row">
                <button class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_editName))" @onclick="SaveOrganizationAsync">Save</button>
                <button disabled="@_busy" @onclick="() => _editSlug = string.Empty">Cancel</button>
            </div>
        }

        @if (_access is { IsMaster: true })
        {
            <h3>Add an organization</h3>
            <div class="form-row">
                <input placeholder="Name, e.g. NextLayerSec" @bind="_newOrganization" @bind:event="oninput" />
                <input placeholder="Operator group object id (optional)" @bind="_newOrganizationGroup" @bind:event="oninput" />
                <button class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_newOrganization))" @onclick="AddOrganizationAsync">Add</button>
            </div>
        }
    }
</section>

@if (_access is { CanAdminister: true })
{
    <section>
        <h2>Recent activity</h2>
        <p class="sub">Who changed what: organizations, groups, clients, providers, imports. DNS changes have their
           own trail on the Fix page.</p>
        @if (_activity is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_activity.Count == 0)
        {
            <p class="muted">Nothing yet.</p>
        }
        else
        {
            <table class="triage">
                <thead><tr><th>When</th><th>Who</th><th>What</th><th>Detail</th></tr></thead>
                <tbody>
                    @foreach (var a in _activity)
                    {
                        <tr>
                            <td class="muted">@a.At.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@a.Actor</td>
                            <td><code>@a.Action</code></td>
                            <td class="muted">@a.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

<section>
    <h2>Database</h2>
    <table class="triage">
        <tbody>
            <tr><td>Path</td><td><code>@Db.Path</code></td></tr>
            <tr>
                <td>Present</td>
                <td>
                    @if (Db.Exists)
                    {
                        <span class="good">yes</span>
                    }
                    else
                    {
                        @* Absolute path, because "dmarc.db" sends somebody
                           looking in whichever directory they happen to be in. *@
                        <span class="bad">no — nothing has been imported yet</span>
                    }
                </td>
            </tr>
            <tr><td>Opened</td><td>read-only, except onboarding and import</td></tr>
            @* What is kept, and for how long, said where somebody can read it
               without opening a unit file. A product that deletes a
               customer's history on a schedule has to be able to answer "for
               how long" on a screen. *@
            <tr>
                <td>Aggregate reports kept</td>
                <td>
                    @Retention.AggregateDays days
                    <span class="muted">— about @(Retention.AggregateDays / 30) months, so a monthly
                          report still has last year's same month to sit beside</span>
                </td>
            </tr>
            <tr>
                <td>Forensic reports kept</td>
                <td>
                    @Retention.ForensicDays days
                    <span class="muted">— these hold real message headers, so they are kept for the
                          shortest time of anything here</span>
                </td>
            </tr>
            <tr>
                <td>Applied by</td>
                <td>
                    <code>dmarc prune</code>, weekly
                    <span class="muted">— nothing is ever deleted silently: every run that removes
                          anything is in the activity log above. Domains and clients are never
                          removed, only the reports age out.</span>
                </td>
            </tr>
        </tbody>
    </table>
    <p class="sub">
        These are the defaults the shipped timer uses. To change them, edit the two numbers in
        <code>dmarc-prune.service</code> — they are stated there rather than left to a default that
        could move in a later release.
    </p>
</section>

<section>
    <h2>This build</h2>
    <p class="sub">Development happens on branches; this machine runs a released version. Nothing
       here installs anything - it says what exists, and updating is a command somebody runs.</p>
    <table class="triage">
        <tbody>
            <tr>
                <td>Running</td>
                <td>
                    <code>@DmarcMonitor.Core.Updates.BuildInfo.Version</code>
                    @if (!DmarcMonitor.Core.Updates.BuildInfo.IsRelease)
                    {
                        <span class="muted"> — built from a working tree, not a release tag</span>
                    }
                </td>
            </tr>
            <tr><td>Database schema</td><td><code>@_schema</code></td></tr>
            @if (UpdatesConfigured)
            {
                <tr>
                    <td>Releases</td>
                    <td>
                        @if (_update is null)
                        {
                            <span class="muted">checking…</span>
                        }
                        else
                        {
                            <span class="@(_update.UpdateAvailable ? "bad" : "")">@_update.Summary</span>
                            @if (_update is { UpdateAvailable: true })
                            {
                                <br />
                                <span class="sub"><a href="updates">Install it from the Updates page</a>.</span>
                            }
                        }
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td>Releases</td>
                    <td><span class="muted">not checked. Set <code>Updates:Repository</code> to be told
                        when a newer version exists.</span></td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section>
    <h2>DNS providers</h2>
    <p class="sub">Which provider holds each client's zones, so the Fix page can write to them. Only
       the coordinates are shown; the token is stored once, under the reference shown, and never
       displayed again. A token on a settings page is a token in a screenshot in a support ticket.</p>
    <table class="triage">
        <tbody>
            <tr><td>Secrets</td><td>@Fixes.SecretsDescription</td></tr>
        </tbody>
    </table>

    @if (_providers is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (_providers.Count == 0)
    {
        <p class="muted">None configured. Fixes can be planned but not applied.</p>
    }
    else
    {
        <table class="triage">
            <thead>
                <tr><th>Zone(s)</th><th>Provider</th><th>Coordinates</th><th>Credential</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in _providers)
                {
                    <tr>
                        <td>@(p.Domain ?? $"every domain of {p.ClientSlug}")</td>
                        <td>@p.Provider</td>
                        <td>
                            @foreach (var kv in p.Settings)
                            {
                                <code>@kv.Key=@kv.Value</code><br />
                            }
                            @if (p.LastError is not null)
                            {
                                <span class="bad">@p.LastError</span>
                            }
                        </td>
                        <td>@if (p.CredentialRef is not null) { <code>@p.CredentialRef</code> } else { <span class="muted">none</span> }</td>
                        <td>
                            @if (_access is { CanAdminister: true })
                            {
                                <button disabled="@_busy" @onclick="() => RemoveProviderAsync(p)">Remove</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_providerMessage is not null)
    {
        <p class="@(_providerMessageIsError ? "bad" : "good")">@_providerMessage</p>
    }

    @if (_access is { CanAdminister: true })
    {
    <h3>Add or replace</h3>
    <div class="form-row">
        <select @bind="_client">
            <option value="">Client…</option>
            @foreach (var c in _clients)
            {
                <option value="@c.Slug">@c.Name</option>
            }
        </select>
        <input placeholder="Domain (blank = every domain of the client)" @bind="_domain" @bind:event="oninput" />
        <select @bind="_provider">
            <option value="cloudflare">Cloudflare</option>
            <option value="azuredns">Azure DNS</option>
            <option value="manual">Manual (no API)</option>
        </select>
    </div>
    @if (_provider == "cloudflare")
    {
        <div class="form-row">
            <input placeholder="Zone id" @bind="_zoneId" @bind:event="oninput" />
            <input type="password" class="wide" placeholder="API token — Zone:DNS:Edit on this zone only, never the Global API Key"
                   @bind="_secret" @bind:event="oninput" autocomplete="off" />
        </div>
    }
    else if (_provider == "azuredns")
    {
        <div class="form-row">
            <input placeholder="Subscription id" @bind="_subscription" @bind:event="oninput" />
            <input placeholder="Resource group" @bind="_resourceGroup" @bind:event="oninput" />
            <input placeholder="Zone name" @bind="_zone" @bind:event="oninput" />
        </div>
        <div class="form-row">
            <input placeholder="Tenant id (optional)" @bind="_tenantId" @bind:event="oninput" />
            <input placeholder="App (client) id (optional)" @bind="_clientId" @bind:event="oninput" />
            <input type="password" placeholder="Client secret (optional)" @bind="_secret" @bind:event="oninput" autocomplete="off" />
        </div>
        <p class="sub">Without an app registration the service's own identity is used: a managed identity
           on a server, or whoever is signed in to az on a desk.</p>
    }
    <div class="form-row">
        <button class="primary" disabled="@(_busy || !Fixes.SecretsAvailable || string.IsNullOrWhiteSpace(_client))" @onclick="SetProviderAsync">Save</button>
        @if (!Fixes.SecretsAvailable)
        {
            <span class="bad">The secret store cannot be used here, so nothing can be saved.</span>
        }
        else if (_clients.Count == 0)
        {
            @* A provider is stored per client, so with no clients the dropdown
               is empty and Save can never enable. The Fix page sends people
               here to configure a provider, and on a fresh install they
               arrived at a form that silently could not be used. *@
            <span class="bad">
                No clients yet, and a provider is stored against a client.
                <a href="clients">Add one under Clients</a> first — domains arrive under
                "Unassigned" and can be filed from there.
            </span>
        }
    </div>
    }
    else
    {
        <p class="sub">Adding or removing a provider needs the admin role.</p>
    }
</section>

<section>
    <h2>Reports</h2>
    <table class="triage">
        <tbody>
            <tr>
                <td>Provider name</td>
                <td>
                    <code>@ReportUi.ProviderName</code>
                    @if (!ReportUi.IsProviderNameSet)
                    {
                        <span class="muted"> — not set, so reports say this literally.
                            Set <code>Reporting:ProviderName</code>.</span>
                    }
                </td>
            </tr>
            <tr><td>Period</td><td>the last complete calendar month</td></tr>
        </tbody>
    </table>
</section>

@code {
    private IReadOnlyList<DmarcMonitor.Core.Remediation.DnsProviderConfig>? _providers;
    private IReadOnlyList<DmarcMonitor.Core.Storage.ReportStore.ClientSummary> _clients = [];
    private string? _providerMessage;
    private bool _providerMessageIsError;
    private bool _busy;

    private string _client = "";
    private string _domain = "";
    private string _provider = "cloudflare";
    private string _zoneId = "";
    private string _subscription = "";
    private string _resourceGroup = "";
    private string _zone = "";
    private string _tenantId = "";
    private string _clientId = "";
    private string _secret = "";

    private DmarcMonitor.Core.Updates.UpdateStatus? _update;
    private string _schema = "unknown";

    private bool UpdatesConfigured => !string.IsNullOrWhiteSpace(Configuration["Updates:Repository"]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After the page is up, because it reaches GitHub: a settings page
        // that will not render until an outbound request comes back is a
        // settings page nobody can read when the network is the problem.
        if (!firstRender || !UpdatesConfigured) { return; }

        _update = await Releases.CheckAsync(
            Configuration["Updates:Repository"]!,
            DmarcMonitor.Core.Updates.BuildInfo.Version,
            Configuration["Updates:Channel"] ?? DmarcMonitor.Core.Updates.ReleaseChannel.Stable,
            Configuration["Updates:Token"]);

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (Db.Exists)
        {
            try
            {
                _schema = await DmarcMonitor.Core.Storage.DatabaseMigrations.VersionAsync(Db.Path);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                _schema = "could not be read";
            }
        }

        if (!Db.Exists) { _providers = []; _organizations = []; return; }

        try
        {
            _access = await Org.GetAsync();

            // What this login may see, not the whole install. Every
            // organization - names, slugs, which role groups exist, counts,
            // logos - and every DNS provider config went to any signed-in
            // user, including another organization's viewer and a customer's
            // own login. The master sees every organization; anybody else
            // sees the ones they belong to; provider configs are for the
            // provider's own people, never a customer.
            var all = await Organizations.ListAsync();
            _organizations = _access.IsMaster
                ? all
                : [.. all.Where(o => _access.Visible.Any(v => v.Slug == o.Slug))];
            _activity = _access.CanAdminister ? await Audit.ListAsync(_access.TenantId, 30) : [];
            _providers = _access.CanOperate && _access.RestrictedClient is null
                ? await Fixes.ProvidersAsync(_access.TenantId)
                : [];
            _clients = [.. (await Onboarding.GetClientsAsync(_access.TenantId))
                .Where(c => c.Slug != DmarcMonitor.Core.Storage.ReportStore.UnassignedClientSlug)];
        }
        catch (Exception ex)
        {
            _providers = [];
            _providerMessage = ex.Message;
            _providerMessageIsError = true;
        }
    }

    private async Task SetProviderAsync()
    {
        // The handler runs on the server; a hidden form is not a permission.
        if (_access is not { CanAdminister: true }) { return; }

        _busy = true;
        try
        {
            var settings = new Dictionary<string, string>();
            void Put(string key, string value) { if (!string.IsNullOrWhiteSpace(value)) { settings[key] = value.Trim(); } }
            Put("zone_id", _zoneId);
            Put("subscription_id", _subscription);
            Put("resource_group", _resourceGroup);
            Put("zone", _zone);
            Put("tenant_id", _tenantId);
            Put("client_id", _clientId);

            var saved = await Fixes.SetProviderAsync(_access.TenantId, _client, string.IsNullOrWhiteSpace(_domain) ? null : _domain.Trim(),
                _provider, settings, string.IsNullOrWhiteSpace(_secret) ? null : _secret);

            _providerMessage = $"{saved.Provider} saved for {saved.Domain ?? $"every domain of {saved.ClientSlug}"}.";
            _providerMessageIsError = false;
            await Audit.RecordAsync(_access.Current?.Id, _access.User, "provider.set", $"{saved.Provider} for {saved.Domain ?? saved.ClientSlug}");

            // The token is dropped from the page's memory the moment it is
            // stored. It is not shown back, and a re-render must not carry it.
            _secret = "";
            _providers = await Fixes.ProvidersAsync(_access?.TenantId);
        }
        catch (Exception ex)
        {
            _providerMessage = ex.Message;
            _providerMessageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveProviderAsync(DmarcMonitor.Core.Remediation.DnsProviderConfig config)
    {
        if (_access is not { CanAdminister: true }) { return; }

        _busy = true;
        try
        {
            await Fixes.RemoveProviderAsync(_access.TenantId, config.ClientSlug, config.Domain);
            _providerMessage = "Removed, and its credential with it.";
            _providerMessageIsError = false;
            await Audit.RecordAsync(_access.Current?.Id, _access.User, "provider.removed", $"{config.Provider} for {config.Domain ?? config.ClientSlug}");
            _providers = await Fixes.ProvidersAsync(_access?.TenantId);
        }
        catch (Exception ex)
        {
            _providerMessage = ex.Message;
            _providerMessageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private bool EntraConfigured => AuthSetup.IsEntraConfigured(Configuration);
    private bool LocalModeRemote => AuthSetup.LocalModeAllowedRemotely(Configuration);

    // ---- organizations --------------------------------------------------------

    private DmarcMonitor.Core.Tenancy.OrganizationAccess? _access;
    private IReadOnlyList<DmarcMonitor.Core.Tenancy.Organization>? _organizations;
    private IReadOnlyList<DmarcMonitor.Core.Tenancy.AuditEntry>? _activity;
    private string? _organizationMessage;
    private bool _organizationMessageIsError;
    private string _newOrganization = "";
    private string _newOrganizationGroup = "";

    private string _editSlug = "";
    private string _editName = "";
    private string _editAdmin = "";
    private string _editOperator = "";
    private string _editEngineer = "";
    private string _editViewer = "";
    private string _editColor = "";
    private string _editProvider = "";
    private string _editContact = "";
    private string? _editLogo;
    private string? _editLogoProblem;

    /// <summary>A master edits any organization; an admin edits their own.</summary>
    private bool CanEdit(DmarcMonitor.Core.Tenancy.Organization o) =>
        _access is { IsMaster: true }
        || (_access is not null && _access.Roles.GetValueOrDefault(o.Slug) >= DmarcMonitor.Core.Tenancy.OrganizationRole.Admin);

    private void BeginEdit(DmarcMonitor.Core.Tenancy.Organization o)
    {
        if (!CanEdit(o)) { return; }
        _editSlug = o.Slug;
        _editName = o.Name;
        _editAdmin = o.AdminGroupId ?? "";
        _editOperator = o.EntraGroupId ?? "";
        _editEngineer = o.EngineerGroupId ?? "";
        _editViewer = o.ViewerGroupId ?? "";
        _editColor = o.Brand.PrimaryColor ?? "";
        _editProvider = o.Brand.ProviderName ?? "";
        _editContact = o.Brand.ContactBlock ?? "";
        _editLogo = o.Brand.Logo;
        _editLogoProblem = null;
    }

    private async Task OnLogoAsync(InputFileChangeEventArgs e)
    {
        _editLogoProblem = null;
        var file = e.File;
        if (file.Size > DmarcMonitor.Core.Tenancy.OrganizationBrand.MaxLogoLength * 3 / 4)
        {
            _editLogoProblem = $"That file is too big; a logo has to fit in {DmarcMonitor.Core.Tenancy.OrganizationBrand.MaxLogoLength / 1000} KB.";
            return;
        }

        try
        {
            using var buffer = new MemoryStream();
            await using var stream = file.OpenReadStream(DmarcMonitor.Core.Tenancy.OrganizationBrand.MaxLogoLength);
            await stream.CopyToAsync(buffer);
            var candidate = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
            if (!DmarcMonitor.Core.Tenancy.OrganizationBrand.IsValidLogo(candidate))
            {
                _editLogoProblem = "That is not an image type a browser draws (PNG, JPEG, GIF, WebP or SVG).";
                return;
            }
            _editLogo = candidate;
        }
        catch (Exception ex)
        {
            _editLogoProblem = ex.Message;
        }
    }

    private async Task SaveOrganizationAsync()
    {
        // Checked here as well as in the markup: the handler runs on the
        // server, and a hidden form is not a permission.
        var org = _organizations?.FirstOrDefault(o => o.Slug == _editSlug);
        if (org is null || !CanEdit(org) || _access is null) { return; }

        _busy = true;
        try
        {
            var changed = new List<string>();
            if (!string.Equals(org.Name, _editName.Trim(), StringComparison.Ordinal))
            {
                await Organizations.RenameAsync(org.Slug, _editName);
                changed.Add($"renamed to {_editName.Trim()}");
            }

            foreach (var (role, value, was) in new[]
                     {
                         (DmarcMonitor.Core.Tenancy.OrganizationRole.Admin, _editAdmin, org.AdminGroupId),
                         (DmarcMonitor.Core.Tenancy.OrganizationRole.Engineer, _editEngineer, org.EngineerGroupId),
                         (DmarcMonitor.Core.Tenancy.OrganizationRole.Tech, _editOperator, org.EntraGroupId),
                         (DmarcMonitor.Core.Tenancy.OrganizationRole.Viewer, _editViewer, org.ViewerGroupId),
                     })
            {
                var wanted = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
                if (!string.Equals(wanted, was, StringComparison.OrdinalIgnoreCase))
                {
                    await Organizations.SetGroupAsync(org.Slug, role, wanted);
                    changed.Add($"{role.ToString().ToLowerInvariant()} group {(wanted ?? "cleared")}");
                }
            }

            var brand = new DmarcMonitor.Core.Tenancy.OrganizationBrand(
                string.IsNullOrWhiteSpace(_editColor) ? null : _editColor.Trim(),
                _editLogo,
                string.IsNullOrWhiteSpace(_editProvider) ? null : _editProvider.Trim(),
                string.IsNullOrWhiteSpace(_editContact) ? null : _editContact.Trim());
            if (brand != org.Brand)
            {
                await Organizations.SetBrandAsync(org.Slug, brand);
                changed.Add("branding");
            }

            _organizationMessage = changed.Count == 0
                ? "Nothing changed."
                : $"{org.Name}: {string.Join(", ", changed)}. Group changes apply after the people concerned sign out and back in.";
            _organizationMessageIsError = false;

            if (changed.Count > 0)
            {
                await Audit.RecordAsync(org.Id, _access.User, "organization.updated", $"{org.Slug}: {string.Join(", ", changed)}");
            }

            _editSlug = "";
            _organizations = await Organizations.ListAsync();
            _activity = await Audit.ListAsync(_access.TenantId, 30);
        }
        catch (Exception ex)
        {
            _organizationMessage = ex.Message;
            _organizationMessageIsError = true;
        }
        finally { _busy = false; }
    }

    private async Task AddOrganizationAsync()
    {
        if (_access is not { IsMaster: true }) { return; }
        _busy = true;
        try
        {
            var created = await Organizations.CreateAsync(_newOrganization, null, _newOrganizationGroup);
            if (created is null)
            {
                _organizationMessage = $"An organization filed as '{DmarcMonitor.Core.Storage.ReportStore.Slugify(_newOrganization)}' already exists.";
                _organizationMessageIsError = true;
            }
            else
            {
                _organizationMessage = $"Added {created.Name}, filed as '{created.Slug}'. It appears in the sidebar switcher on the next page load.";
                _organizationMessageIsError = false;
                await Audit.RecordAsync(null, _access.User, "organization.added", $"{created.Name} ({created.Slug})");
                _newOrganization = "";
                _newOrganizationGroup = "";
                _organizations = await Organizations.ListAsync();
                _activity = await Audit.ListAsync(_access.TenantId, 30);
            }
        }
        catch (Exception ex)
        {
            _organizationMessage = ex.Message;
            _organizationMessageIsError = true;
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// Never renders a secret. Identifiers are fine to show and are what an
    /// operator is checking; a client secret on a settings page is a secret in
    /// a screenshot in a support ticket.
    /// </summary>
    private string Show(string key) =>
        Configuration[key] is { Length: > 0 } value ? value : "not set";
}
