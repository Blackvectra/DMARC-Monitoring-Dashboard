@page "/domains"
@using DmarcMonitor.Core.Charting
@using DmarcMonitor.Core.Dns
@using DmarcMonitor.Core.Rollout
@using DmarcMonitor.Core.Storage
@using DmarcMonitor.Core.Tenancy
@using DmarcMonitor.Web.Auth
@using DmarcMonitor.Web.Data
@inject TriageService Triage
@inject ReportStoreConnection Db
@inject OrgContext Org
@inject OnboardingService Onboarding
@inject DnsStatusService DnsStatus
@rendermode InteractiveServer

<PageTitle>Domains — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Domains</h1>
        <p class="sub">Every domain alphabetically, for looking one up. Triage is the same set ordered by
           what needs doing, which is the one to open when you do not already know what you are after.</p>
    </div>
    <div class="head-actions">
        @if (_clients.Count > 1 && _access?.RestrictedClient is null)
        {
            <label>
                Client
                <select @bind="_client" aria-label="Client">
                    <option value="">All clients</option>
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Slug">@c.Name</option>
                    }
                </select>
            </label>
        }
        <label>
            Window
            <select @bind="_days" @bind:after="LoadAsync">
                <option value="7">7 days</option>
                <option value="30">30 days</option>
                <option value="90">90 days</option>
            </select>
        </label>
    </div>
</header>

@* What the record chips are drawn from, and whether it is current. A tick
   with nothing behind it is the thing this feature has to avoid producing,
   so the age of the reading is on the page rather than only in a tooltip. *@
@if (_rows is { Count: > 0 })
{
    <div class="dns-state">
        @if (_scanning)
        {
            <span class="muted">Reading DNS…</span>
        }
        else if (_scanMessage is not null)
        {
            <span class="muted">@_scanMessage</span>
        }
        else if (_lastRead is null)
        {
            <span class="muted">
                DNS has not been read yet, so the SPF, DKIM and DMARC columns say only that.
                The scheduled scan fills them: <code>dmarc check --all --save</code>
            </span>
        }
        else if (_stale > 0)
        {
            <span class="muted">
                DNS last read @Ago(_lastRead).
                @_stale of @_rows.Count domain@(_rows.Count == 1 ? "" : "s") not read in the last
                @RecordStatus.StaleAfterDays days — the nightly scan may not be running.
            </span>
        }
        else
        {
            <span class="muted">DNS last read @Ago(_lastRead).</span>
        }

        @if (_access is { CanOperate: true } && Db.Exists)
        {
            <button class="linkish" disabled="@_scanning" @onclick="RefreshDnsAsync">Read DNS now</button>
        }
    </div>
}

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been imported.</p>
        <pre>dmarc init-db --db @Db.Path</pre>
    </div>
}
else if (_rows is null)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="empty">
        <h2>No domains yet</h2>
        <p>Reports create domains as they arrive. Import a folder or run an ingest.</p>
    </div>
}
else
{
    <div class="list-controls">
        <input class="find" type="search" placeholder="Filter by domain or client"
               aria-label="Filter by domain or client"
               @bind="_filter" @bind:event="oninput" />

        <label class="toggle">
            <input type="checkbox" @bind="_byClient" />
            Group by client
        </label>

        @if (!string.IsNullOrWhiteSpace(_filter) || !string.IsNullOrEmpty(_client))
        {
            <span class="muted">@Filtered.Count of @_rows.Count</span>
        }
    </div>

    @if (Filtered.Count == 0)
    {
        <p class="muted">Nothing matches “@_filter”.</p>
    }
    else if (_byClient && string.IsNullOrEmpty(_client))
    {
        @* One section per customer. This is the view that matters as the book
           grows: an MSP is asked "how is Morton doing", not "how is
           mortonnd.gov doing", and a flat alphabetical list of eighty domains
           cannot answer that without the reader doing the grouping by eye.
           Across organizations the grouping is by organization first, so two
           customers with the same name in different organizations do not
           collapse into one heading. *@
        @foreach (var group in Filtered
            .GroupBy(r => (AcrossOrganizations ? r.Organization + " / " : "") + r.ClientName)
            .OrderBy(g => g.Key, StringComparer.Ordinal))
        {
            <section>
                <h2>
                    @(string.IsNullOrWhiteSpace(group.Key) ? "Unassigned" : group.Key)
                    <span class="pill">@group.Count() domain(s)</span>
                </h2>
                @DomainTable(group)
            </section>
        }
    }
    else
    {
        @DomainTable(Filtered)
    }
}

@* One definition, rendered either once or once per client. Two copies of a
   table drift, and the columns here are the ones somebody compares across
   rows. *@
@{
    RenderFragment DomainTable(IEnumerable<DomainTriage> rows) =>
    @<div class="table-scroll">
        <table class="triage">
            <thead>
                <tr>
                    <th></th>
                    <th>Domain</th>
                    @if (!_byClient && AcrossOrganizations) { <th>Organization</th> }
                    @if (!_byClient) { <th>Client</th> }
                    <th>Records</th>
                    <th>Policy</th>
                    <th class="num">Volume</th>
                    <th class="num">Passing</th>
                    <th class="num">Sources</th>
                    <th>Last report</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td><span class="pip @Css(row.Level)" title="@row.Headline"></span></td>
                        <td><a href="@($"domains/{Uri.EscapeDataString(row.Domain)}")">@row.Domain</a></td>
                        @if (!_byClient && AcrossOrganizations) { <td class="muted">@row.Organization</td> }
                        @if (!_byClient) { <td class="muted">@row.ClientName</td> }
                        <td class="records">
                            @* Each chip carries its own name and its own shape,
                               not only a color: about one man in twelve cannot
                               tell the red from the green, and a column of
                               eighty rows distinguished by hue alone is a
                               column that person cannot read at all. *@
                            @foreach (var chip in RecordStatus.For(Dns(row.Domain)))
                            {
                                @* role="img" so the label is what gets read.
                                   Without it a screen reader announces "SPF"
                                   and stops - the state is carried by a glyph
                                   and a color, and both are hidden from it.
                                   title is the same sentence for a pointer. *@
                                <span class="chip @chip.Css @(chip.Stale ? "stale" : "")"
                                      role="img" aria-label="@($"{chip.Label} for {row.Domain}: {chip.Title}")"
                                      title="@chip.Title">
                                    <span class="chip-name">@chip.Label</span><span class="chip-mark">@chip.Glyph</span>
                                </span>
                            }
                        </td>
                        <td><code>p=@row.Policy</code></td>
                        <td class="num vol">
                            <span class="vol-count">@row.Messages.ToString("N0")</span>
                            @* Ranks the column by eye; the number above it is
                               what anybody reads for the quantity. Scaled
                               against the largest row on screen, so filtering
                               to one client rescales to that client rather
                               than leaving every bar a sliver of the busiest
                               domain in the book. *@
                            <span class="vol-bar" aria-hidden="true">
                                <span style="width:@Width(row.Messages)%"></span>
                            </span>
                        </td>
                        <td class="num">
                            @if (row.Messages > 0)
                            {
                                <span class="@(row.PassRate < 95 ? "bad" : "good")">@row.PassRate%</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                        <td class="num">@row.Sources</td>
                        <td class="muted">@Ago(row.LastReport)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>;
}

@code {
    private OrganizationAccess? _access;
    private IReadOnlyList<ReportStore.ClientSummary> _clients = [];
    private IReadOnlyList<DomainTriage>? _rows;
    private IReadOnlyDictionary<string, DomainDns> _dns =
        new Dictionary<string, DomainDns>(StringComparer.OrdinalIgnoreCase);
    private DateTimeOffset? _lastRead;
    private int _stale;
    private bool _scanning;
    private string? _scanMessage;
    private string? _error;
    private string _filter = "";
    private string _client = "";
    private int _days = 30;
    private bool _byClient;

    private bool AcrossOrganizations => _access is { IsMaster: true, Current: null, Visible.Count: > 1 };

    /// <summary>
    /// What is stored about a domain's DNS, or an unread one.
    /// </summary>
    /// <remarks>
    /// The fallback is not an empty record standing for "nothing published".
    /// It is a domain nobody has looked at, which RecordStatus draws as three
    /// dashes rather than three crosses - the whole distinction this feature
    /// rests on.
    /// </remarks>
    private DomainDns Dns(string domain) =>
        _dns.TryGetValue(domain, out var found) ? found : new DomainDns { Domain = domain };

    /// <summary>
    /// The busiest row currently on screen, which every volume bar is drawn
    /// against.
    /// </summary>
    /// <remarks>
    /// Taken from the filtered set rather than from the whole book on
    /// purpose. Narrowing to one client should rescale that client's bars to
    /// each other; against a fixed maximum, a customer whose busiest domain
    /// sends a thousandth of the largest domain in the book would see ten
    /// identical slivers and learn nothing.
    /// </remarks>
    private long _busiest;

    /// <summary>
    /// The bar's width, written invariantly.
    /// </summary>
    /// <remarks>
    /// Through Chart.Percent rather than interpolated as a double, because a
    /// server whose locale uses a comma for the decimal point would emit
    /// "width:90,69%" - which a browser drops as an invalid declaration,
    /// leaving every bar at its default width. The page still renders, so it
    /// would read as a styling quirk rather than as a broken chart, and
    /// nobody developing on an en-US machine would ever see it.
    /// </remarks>
    private string Width(long messages)
    {
        _ = Filtered;   // whose computation is also what sets the scale
        return Chart.Percent(Chart.BarWidth(messages, _busiest));
    }

    // Alphabetical, not by urgency. Triage already ranks; this exists to find
    // a named domain, and a list that reorders itself as data changes is the
    // wrong tool for that.
    //
    // Memoized because one render reads it several times - the count, the
    // grouping, the rows, and the scale every volume bar is drawn against -
    // and recomputing the filter inside the loop that the filter produced
    // makes the page quadratic in the size of the book.
    private (string Filter, string Client, object? Source) _filteredFrom = ("", "", null);
    private IReadOnlyList<DomainTriage> _filtered = [];

    private IReadOnlyList<DomainTriage> Filtered
    {
        get
        {
            var from = (_filter, _client, (object?)_rows);
            if (_filteredFrom != from)
            {
                _filtered = _rows is null ? []
                    : [.. _rows
                        .Where(r => string.IsNullOrEmpty(_client) || r.ClientSlug.Equals(_client, StringComparison.OrdinalIgnoreCase))
                        .Where(r => string.IsNullOrWhiteSpace(_filter)
                                 || r.Domain.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                                 || r.ClientName.Contains(_filter, StringComparison.OrdinalIgnoreCase))
                        .OrderBy(r => r.Domain, StringComparer.Ordinal)];
                _busiest = _filtered.Count == 0 ? 0 : _filtered.Max(r => r.Messages);
                _filteredFrom = from;
            }

            return _filtered;
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;

        // Whatever the last refresh reported describes a reading that has now
        // been replaced, so it goes when the data does. RefreshDnsAsync sets
        // it again after calling this.
        _scanMessage = null;
        if (!Db.Exists) { _rows = Array.Empty<DomainTriage>(); return; }

        try
        {
            _access = await Org.GetAsync();
            var tenant = _access.TenantId;

            _clients = [.. (await Onboarding.GetClientsAsync(tenant))
                .Where(c => c.Slug != ReportStore.UnassignedClientSlug || c.Domains > 0)];
            if (!string.IsNullOrEmpty(_client) && _clients.All(c => c.Slug != _client)) { _client = ""; }

            // Grouped by default once there is something to group: a book of
            // one client per domain gains nothing from it, a book of clients
            // with several domains each is unreadable without it.
            if (_rows is null) { _byClient = _clients.Count > 1 && _clients.Any(c => c.Domains > 1); }

            if (_access.RestrictedClient is { } only) { _client = only; }

            _rows = await Triage.GetAsync(_days, tenant, _access.RestrictedClient);

            // Read from storage, never resolved here: a table of eighty rows
            // would otherwise be eighty DNS lookups per render, each able to
            // hang for five seconds, on a page somebody reloads.
            _dns = await DnsStatus.GetAsync(tenant, _access.RestrictedClient);
            Summarize();
        }
        catch (Exception ex)
        {
            _rows = Array.Empty<DomainTriage>();
            _error = ex.Message;
        }
    }

    /// <summary>
    /// How current the readings behind the chips are.
    /// </summary>
    /// <remarks>
    /// The newest reading rather than the oldest, with the count of stale ones
    /// beside it. The oldest alone would report the whole page as out of date
    /// because of one domain that has been failing to resolve for a month,
    /// and that reads as "this feature is broken" rather than as "one domain
    /// needs looking at".
    /// </remarks>
    private void Summarize()
    {
        var read = _dns.Values.Select(d => d.CheckedAt).Where(at => at is not null).ToList();

        _lastRead = read.Count == 0 ? null : read.Max();
        _stale = _rows is null ? 0 : _rows.Count(r => RecordStatus.Spf(Dns(r.Domain)) is { Stale: true } or { State: RecordState.Unknown });
    }

    /// <summary>
    /// Reads the DNS of everything in scope again, now.
    /// </summary>
    /// <remarks>
    /// The scheduled scan is what normally fills this in. The button exists
    /// because a fresh install has no readings until that first fires, and a
    /// page of dashes with no way to do anything about them is a feature that
    /// looks broken on the day somebody sets it up.
    /// </remarks>
    private async Task RefreshDnsAsync()
    {
        if (_access is not { CanOperate: true } || _scanning || !Db.Exists) { return; }

        _scanning = true;
        _scanMessage = null;
        string? outcome;

        try
        {
            var summary = await DnsStatus.RefreshAsync(_access.TenantId, _access.RestrictedClient, _access.User);

            outcome = summary is null
                ? "There is no database to store a reading in."
                : $"Read {summary.Read} domain(s)"
                  + (summary.Failed > 0 ? $", {summary.Failed} could not be resolved" : "")
                  + (summary.Missing > 0 ? $", {summary.Missing} do not exist" : "")
                  + (summary.Changed > 0 ? $", {summary.Changed} changed since last time" : "")
                  + (summary.Skipped > 0
                      ? $". {summary.Skipped} not read: a page can only do {DnsStatusService.RefreshLimit} at a time, "
                        + "and the rest are the scheduled scan's work."
                      : ".");
        }
        catch (Exception ex)
        {
            outcome = $"Could not read DNS: {ex.Message}";
        }
        finally
        {
            _scanning = false;
        }

        // Reloaded first, because LoadAsync clears the message: what is shown
        // has to describe the readings now on screen.
        await LoadAsync();
        _scanMessage = outcome;
    }

    private static string Ago(DateTimeOffset? when)
    {
        if (when is null) { return "never"; }

        var days = (int)(DateTimeOffset.UtcNow - when.Value).TotalDays;
        return days switch
        {
            <= 0 => "today",
            1 => "yesterday",
            _ => $"{days} days ago",
        };
    }

    private static string Css(TriageLevel level) => level switch
    {
        TriageLevel.Urgent => "urgent",
        TriageLevel.Act => "act",
        TriageLevel.Watch => "watch",
        TriageLevel.OnTrack => "ontrack",
        _ => "fine",
    };
}
