@page "/domains"
@using DmarcMonitor.Core.Charting
@using DmarcMonitor.Core.Dns
@using DmarcMonitor.Core.Rollout
@using DmarcMonitor.Core.Storage
@using DmarcMonitor.Core.Tenancy
@using DmarcMonitor.Web.Auth
@using DmarcMonitor.Web.Data
@inject TriageService Triage
@inject ReportStoreConnection Db
@inject OrgContext Org
@inject OnboardingService Onboarding
@inject DnsStatusService DnsStatus
@rendermode InteractiveServer

<PageTitle>Domain health — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Domain health</h1>
        <p class="sub">Every domain in one table: look one up by name, or press a column to put the ones that
           are failing, quiet or still at p=none first. The dashboard ranks the same set by what needs doing.</p>
    </div>
    <div class="head-actions">
        @if (_clients.Count > 1 && _access?.RestrictedClient is null)
        {
            <label>
                Client
                <select @bind="_client" @bind:after="ClientChanged" aria-label="Client">
                    <option value="">All clients</option>
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Slug">@c.Name</option>
                    }
                </select>
            </label>
        }
        <label>
            Window
            <select @bind="_days" @bind:after="LoadAsync">
                <option value="7">7 days</option>
                <option value="30">30 days</option>
                <option value="90">90 days</option>
            </select>
        </label>
    </div>
</header>

@* What the record chips are drawn from, and whether it is current. A tick
   with nothing behind it is the thing this feature has to avoid producing,
   so the age of the reading is on the page rather than only in a tooltip. *@
@if (_rows is { Count: > 0 })
{
    <div class="dns-state">
        @if (_scanning)
        {
            <span class="muted">Reading DNS…</span>
        }
        else if (_scanMessage is not null)
        {
            <span class="muted">@_scanMessage</span>
        }
        else if (_lastRead is null)
        {
            @* The button that does this is in this same div, three lines
               below. Naming a command to type beside it was the page telling
               somebody to go and do by hand the thing it was offering. *@
            <span class="muted">
                DNS has not been read yet, so the Records column says only that.
                Read it now, or leave it to the nightly scan.
            </span>
        }
        else if (_stale > 0)
        {
            <span class="muted">
                DNS last read @TimeAgo.Days(_lastRead).
                @_stale of @_rows.Count domain@(_rows.Count == 1 ? "" : "s") not read in the last
                @RecordStatus.StaleAfterDays days — the nightly scan may not be running.
            </span>
        }
        else
        {
            <span class="muted">DNS last read @TimeAgo.Days(_lastRead).</span>
        }

        @if (_access is { CanOperate: true } && Db.Exists)
        {
            <button class="linkish" disabled="@_scanning" @onclick="RefreshDnsAsync">Read DNS now</button>
        }
    </div>
}

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been imported.</p>
        <pre>dmarc init-db --db @Db.Path</pre>
    </div>
}
else if (_rows is null)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="empty">
        <h2>No domains yet</h2>
        <p>Reports create domains as they arrive. Import a folder or run an ingest.</p>
    </div>
}
else
{
    @* The policy counts are the filter, as the severity counts are on the
       dashboard: "how many are still at p=none" is the question this page is
       opened to answer, and a number with no way to see those domains is a
       label rather than a tool. *@
    <div class="counts">
        <button type="button" class="count @(_policy is null ? "on" : "")"
                aria-pressed="@((_policy is null).ToString().ToLowerInvariant())"
                @onclick="() => FilterPolicy(null)">@InScope.Count all</button>

        @foreach (var policy in Policies)
        {
            var n = InScope.Count(r => r.Policy == policy);
            @if (n > 0)
            {
                var chosen = _policy == policy;
                <button type="button" class="count @PolicyCss(policy) @(chosen ? "on" : "")"
                        aria-pressed="@chosen.ToString().ToLowerInvariant()"
                        @onclick="() => FilterPolicy(policy)">@n p=@policy</button>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_filter) || _policy is not null)
        {
            <span class="muted">@Filtered.Count of @InScope.Count</span>
        }

        <input class="find" type="search" placeholder="Filter by domain or client"
               aria-label="Filter by domain or client"
               @bind="_filter" @bind:event="oninput" />

        @* Only where there is something to group: a book of one client per
           domain gains nothing from it. Off while the table is ordered by
           anything but name, and says why - a box that is ticked and does
           nothing reads as broken. *@
        @if (DomainList.CanGroup(InScope))
        {
            <label class="toggle" title="@(_sort == DomainSort.Domain ? "Put a client's domains together under its name." : "Off while the table is ordered by another column.")">
                <input type="checkbox" @bind="_byClient" disabled="@(_sort != DomainSort.Domain)" />
                Group by client
                @* In the label itself, not only the title: a title is for a pointer,
                   and the person who cannot tick the box from the keyboard is the one
                   who most needs to be told why. *@
                @if (_sort != DomainSort.Domain)
                {
                    <span class="muted">— off while the table is ordered by another column</span>
                }
            </label>
        }
    </div>

    @if (InScope.Count == 0)
    {
        @* A client with nothing to show: no filter to clear, and a button that
           said "show all 0" would do nothing. *@
        <p class="muted">
            This client has no active domains.
            <button class="linkish" @onclick="ShowAllClients">Show all clients</button>
        </p>
    }
    else if (Filtered.Count == 0)
    {
        @* A filter that matches nothing has to say so. An empty table under a
           search box reads as "no domains", which is not what happened. *@
        <p class="muted">
            Nothing matches.
            <button class="linkish" @onclick="ClearFilters">Show all @InScope.Count</button>
        </p>
    }
    else
    {
        @* One table, whatever the grouping. It used to be one per client, so
           twenty clients meant twenty header rows and twenty sets of columns
           that each sized themselves to their own contents - none of them
           lined up with the one above. A client's heading is a row in this
           table instead. *@
        <div class="table-scroll">
            <table class="triage domains">
                <thead>
                    <tr>
                        <th class="shrink" aria-sort="@Aria(DomainSort.Status)">@SortHeader("Status", DomainSort.Status)</th>
                        <th aria-sort="@Aria(DomainSort.Domain)">@SortHeader("Domain", DomainSort.Domain)</th>
                        @if (AcrossOrganizations) { <th>Organization</th> }
                        <th>Records</th>
                        <th aria-sort="@Aria(DomainSort.Policy)">@SortHeader("Policy", DomainSort.Policy)</th>
                        <th class="num" aria-sort="@Aria(DomainSort.Volume)">@SortHeader("Volume", DomainSort.Volume)</th>
                        <th class="num" aria-sort="@Aria(DomainSort.Passing)">@SortHeader("Passing", DomainSort.Passing)</th>
                        <th class="num" aria-sort="@Aria(DomainSort.Sources)">@SortHeader("Sources", DomainSort.Sources)</th>
                        <th aria-sort="@Aria(DomainSort.LastReport)">@SortHeader("Last report", DomainSort.LastReport)</th>
                    </tr>
                </thead>
                @* A tbody for each client that has a heading, so that the
                   heading's scope="rowgroup" covers its own rows and not
                   everything below it - in a single tbody a reader that honours
                   it applies the first heading to every later domain. *@
                @foreach (var block in Blocks)
                {
                <tbody @key="block.Key">
                    @foreach (var line in block.Lines)
                    {
                        @if (line.Heading is not null)
                        {
                            <tr class="group" @key="line.Key">
                                <th colspan="@Columns" scope="rowgroup">
                                    @line.Heading
                                    <span class="pill">@line.Count domains</span>
                                </th>
                            </tr>
                        }
                        else
                        {
                            var row = line.Row!;
                            var chips = RecordStatus.For(Dns(row.Domain));

                            @* Nothing read yet is one quiet fact, not five
                               boxes: the banner above says why, and a column of
                               outlined dashes eighty rows deep is noise. The
                               chips are still there for the reading to fill in
                               and for a screen reader to be told. *@
                            var unread = chips.All(c => c.State == RecordState.Unknown);

                            <tr class="@(line.Headed ? "headed" : "")" @key="@RowKey(row)">
                                <td class="shrink">
                                    @* A word for a screen reader, and the
                                       headline for anybody hovering: the dot
                                       alone is a color. *@
                                    <span class="pip @Css(row.Level)" role="img"
                                          aria-label="@(string.IsNullOrWhiteSpace(row.Headline) ? Label(row.Level) : $"{Label(row.Level)}: {row.Headline}")"
                                          title="@(string.IsNullOrWhiteSpace(row.Headline) ? Label(row.Level) : row.Headline)"></span>
                                </td>
                                <td class="domain-col">
                                    <a href="@($"domains/{Uri.EscapeDataString(row.Domain)}")">@row.Domain</a>
                                    @* Whose it is, where it is not already said:
                                       not under a client's heading, and not when
                                       the client is only the domain over again,
                                       which onboarding by domain makes most of
                                       them. *@
                                    @if (!line.Headed && NamesAClient(row))
                                    {
                                        <span class="client-line">@row.ClientName</span>
                                    }
                                </td>
                                @if (AcrossOrganizations) { <td class="muted">@row.Organization</td> }
                                <td>
                                    <div class="records @(unread ? "unread" : "")">
                                        @* Each chip carries its own name and its own shape,
                                           not only a color: about one man in twelve cannot
                                           tell the red from the green, and a column of
                                           eighty rows distinguished by hue alone is a
                                           column that person cannot read at all. *@
                                        @foreach (var chip in chips)
                                        {
                                            @* role="img" so the label is what gets read.
                                               Without it a screen reader announces "SPF"
                                               and stops - the state is carried by a glyph
                                               and a color, and both are hidden from it.
                                               title is the same sentence for a pointer. *@
                                            <span class="chip @chip.Css @(chip.Stale ? "stale" : "")"
                                                  role="img" aria-label="@($"{chip.Label} for {row.Domain}: {chip.Title}")"
                                                  title="@chip.Title">
                                                <span class="chip-name">@chip.Label</span><span class="chip-mark">@chip.Glyph</span>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td><code>p=@row.Policy</code></td>
                                <td class="num vol">
                                    <span class="vol-count">@row.Messages.ToString("N0")</span>
                                    @* Ranks the column by eye; the number above it is
                                       what anybody reads for the quantity. Scaled
                                       against the largest row on screen, so filtering
                                       to one client rescales to that client rather
                                       than leaving every bar a sliver of the busiest
                                       domain in the book. *@
                                    <span class="vol-bar" aria-hidden="true">
                                        <span style="width:@Width(row.Messages)%"></span>
                                    </span>
                                </td>
                                <td class="num">
                                    @if (row.Messages > 0)
                                    {
                                        <span class="@(row.PassRate < 95 ? "bad" : "good")">@row.PassRate%</span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td class="num">@row.Sources</td>
                                <td class="when">@TimeAgo.Days(row.LastReport)</td>
                            </tr>
                        }
                    }
                </tbody>
                }
            </table>
        </div>
    }
}

@code {
    /// <summary>The policies there are, weakest first, which is the order the counts read in.</summary>
    private static readonly string[] Policies = ["none", "quarantine", "reject"];

    private OrganizationAccess? _access;
    private IReadOnlyList<ReportStore.ClientSummary> _clients = [];
    private IReadOnlyList<DomainTriage>? _rows;
    private IReadOnlyDictionary<string, DomainDns> _dns =
        new Dictionary<string, DomainDns>(StringComparer.OrdinalIgnoreCase);
    private DateTimeOffset? _lastRead;
    private int _stale;
    private bool _scanning;
    private string? _scanMessage;
    private string? _error;
    private string _filter = "";
    private string _client = "";
    private string? _policy;
    private int _days = 30;
    private bool _byClient;
    private DomainSort _sort = DomainSort.Domain;
    private bool _descending;

    private bool AcrossOrganizations => _access is { IsMaster: true, Current: null, Visible.Count: > 1 };

    private int Columns => 8 + (AcrossOrganizations ? 1 : 0);

    /// <summary>
    /// What is stored about a domain's DNS, or an unread one.
    /// </summary>
    /// <remarks>
    /// The fallback is not an empty record standing for "nothing published".
    /// It is a domain nobody has looked at, which RecordStatus draws as three
    /// dashes rather than three crosses - the whole distinction this feature
    /// rests on.
    /// </remarks>
    private DomainDns Dns(string domain) =>
        _dns.TryGetValue(domain, out var found) ? found : new DomainDns { Domain = domain };

    /// <summary>
    /// The busiest row currently on screen, which every volume bar is drawn
    /// against.
    /// </summary>
    /// <remarks>
    /// Taken from the filtered set rather than from the whole book on
    /// purpose. Narrowing to one client should rescale that client's bars to
    /// each other; against a fixed maximum, a customer whose busiest domain
    /// sends a thousandth of the largest domain in the book would see ten
    /// identical slivers and learn nothing.
    /// </remarks>
    private long _busiest;

    /// <summary>
    /// The bar's width, written invariantly.
    /// </summary>
    /// <remarks>
    /// Through Chart.Percent rather than interpolated as a double, because a
    /// server whose locale uses a comma for the decimal point would emit
    /// "width:90,69%" - which a browser drops as an invalid declaration,
    /// leaving every bar at its default width. The page still renders, so it
    /// would read as a styling quirk rather than as a broken chart, and
    /// nobody developing on an en-US machine would ever see it.
    /// </remarks>
    private string Width(long messages)
    {
        _ = Lines;   // whose computation is also what sets the scale
        return Chart.Percent(Chart.BarWidth(messages, _busiest));
    }

    // The domains in the chosen client, before any narrowing by typing: what
    // the counts are counts of. Counting what the box has left would make the
    // numbers jump while somebody types.
    private (string Client, object? Source) _scopedFrom = ("", null);
    private IReadOnlyList<DomainTriage> _scoped = [];

    private IReadOnlyList<DomainTriage> InScope
    {
        get
        {
            var from = (_client, (object?)_rows);
            if (_scopedFrom != from)
            {
                _scoped = _rows is null ? []
                    : [.. _rows.Where(r => string.IsNullOrEmpty(_client)
                        || r.ClientSlug.Equals(_client, StringComparison.OrdinalIgnoreCase))];
                _scopedFrom = from;
            }

            return _scoped;
        }
    }

    // Memoized because one render reads it several times - the count, the
    // emptiness check, the rows, and the scale every volume bar is drawn
    // against - and recomputing the filter inside the loop that the filter
    // produced makes the page quadratic in the size of the book.
    private (string Filter, string? Policy, DomainSort Sort, bool Descending, bool ByClient, bool Across, object? Scoped) _linesFrom
        = ("", null, DomainSort.Domain, false, false, false, null);
    private IReadOnlyList<DomainTriage> _filtered = [];
    private IReadOnlyList<DomainLine> _lines = [];
    private IReadOnlyList<Block> _blocks = [];

    private void Rebuild()
    {
        var from = (_filter, _policy, _sort, _descending, _byClient, AcrossOrganizations, (object?)InScope);
        if (_linesFrom == from) { return; }

        var needle = _filter.Trim();
        _filtered = [.. InScope
            .Where(r => _policy is null || r.Policy == _policy)
            .Where(r => needle.Length == 0
                     || r.Domain.Contains(needle, StringComparison.OrdinalIgnoreCase)
                     || r.ClientName.Contains(needle, StringComparison.OrdinalIgnoreCase))];
        _busiest = _filtered.Count == 0 ? 0 : _filtered.Max(r => r.Messages);
        _lines = DomainList.Layout(_filtered, _sort, _descending, _byClient, AcrossOrganizations);
        _blocks = BlocksOf(_lines);
        _linesFrom = from;
    }

    /// <summary>A run of lines that share a tbody: a client's heading and its domains, or domains with no heading.</summary>
    private sealed record Block(string Key, IReadOnlyList<DomainLine> Lines);

    /// <summary>
    /// Splits the table into the groups of rows a screen reader should read a
    /// heading over: each heading opens one with its own domains, and domains
    /// that have no heading share one until the next heading comes.
    /// </summary>
    private static List<Block> BlocksOf(IReadOnlyList<DomainLine> lines)
    {
        var blocks = new List<Block>();
        var current = new List<DomainLine>();
        var loose = 0;

        void Close()
        {
            if (current.Count == 0) { return; }

            // Unique among its siblings, which a repeated key would not be: two
            // runs of loose domains can sit either side of a heading.
            var key = current[0].Heading is not null ? $"heading:{current[0].Key}" : $"loose:{loose++}";
            blocks.Add(new Block(key, current));
            current = [];
        }

        foreach (var line in lines)
        {
            // A heading starts a block; so does the first domain after a block
            // of headed ones, which is no longer under that heading.
            var opensBlock = line.Heading is not null
                || (current.Count > 0 && current[0].Heading is not null && !line.Headed);
            if (opensBlock) { Close(); }

            current.Add(line);
        }

        Close();
        return blocks;
    }

    /// <summary>
    /// What identifies a domain's row: the organization it is in and its name.
    /// Both, because two organizations can manage the same name, and the
    /// organization by what it is rather than what it is called, because two
    /// can share a name. A repeated key makes the page refuse to redraw.
    /// </summary>
    private static string RowKey(DomainTriage row) => $"{row.TenantId}/{row.Domain}";

    private IReadOnlyList<DomainTriage> Filtered
    {
        get { Rebuild(); return _filtered; }
    }

    private IReadOnlyList<DomainLine> Lines
    {
        get { Rebuild(); return _lines; }
    }

    private IReadOnlyList<Block> Blocks
    {
        get { Rebuild(); return _blocks; }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var first = _rows is null;
        _error = null;

        // Whatever the last refresh reported describes a reading that has now
        // been replaced, so it goes when the data does. RefreshDnsAsync sets
        // it again after calling this.
        _scanMessage = null;
        if (!Db.Exists) { _rows = Array.Empty<DomainTriage>(); return; }

        try
        {
            _access = await Org.GetAsync();
            var tenant = _access.TenantId;

            _clients = [.. (await Onboarding.GetClientsAsync(tenant))
                .Where(c => c.Slug != ReportStore.UnassignedClientSlug || c.Domains > 0)];
            if (!string.IsNullOrEmpty(_client) && _clients.All(c => c.Slug != _client)) { _client = ""; }

            if (_access.RestrictedClient is { } only) { _client = only; }

            _rows = await Triage.GetAsync(_days, tenant, _access.RestrictedClient);

            // Grouped by default once there is something to group: a book of
            // one client per domain gains nothing from it, a book of clients
            // with several domains each is unreadable without it.
            if (first) { _byClient = DomainList.CanGroup(_rows); }

            // A policy filter on something the new window no longer has - or
            // that the chosen client never had - would leave an empty table and
            // a count of zero to explain it.
            if (_policy is not null && InScope.All(r => r.Policy != _policy)) { _policy = null; }

            // Read from storage, never resolved here: a table of eighty rows
            // would otherwise be eighty DNS lookups per render, each able to
            // hang for five seconds, on a page somebody reloads.
            _dns = await DnsStatus.GetAsync(tenant, _access.RestrictedClient);
            Summarize();
        }
        catch (Exception ex)
        {
            _rows = Array.Empty<DomainTriage>();
            _error = ex.Message;
        }
    }

    /// <summary>
    /// How current the readings behind the chips are.
    /// </summary>
    /// <remarks>
    /// The newest reading rather than the oldest, with the count of stale ones
    /// beside it. The oldest alone would report the whole page as out of date
    /// because of one domain that has been failing to resolve for a month,
    /// and that reads as "this feature is broken" rather than as "one domain
    /// needs looking at".
    /// </remarks>
    private void Summarize()
    {
        var read = _dns.Values.Select(d => d.CheckedAt).Where(at => at is not null).ToList();

        _lastRead = read.Count == 0 ? null : read.Max();
        _stale = _rows is null ? 0 : _rows.Count(r => RecordStatus.Spf(Dns(r.Domain)) is { Stale: true } or { State: RecordState.Unknown });
    }

    /// <summary>
    /// Reads the DNS of everything in scope again, now.
    /// </summary>
    /// <remarks>
    /// The scheduled scan is what normally fills this in. The button exists
    /// because a fresh install has no readings until that first fires, and a
    /// page of dashes with no way to do anything about them is a feature that
    /// looks broken on the day somebody sets it up.
    /// </remarks>
    private async Task RefreshDnsAsync()
    {
        if (_access is not { CanOperate: true } || _scanning || !Db.Exists) { return; }

        _scanning = true;
        _scanMessage = null;
        string? outcome;

        try
        {
            var summary = await DnsStatus.RefreshAsync(_access.TenantId, _access.RestrictedClient, _access.User);

            outcome = summary is null
                ? "There is no database to store a reading in."
                : $"Read {summary.Read} domain(s)"
                  + (summary.Failed > 0 ? $", {summary.Failed} could not be resolved" : "")
                  + (summary.Missing > 0 ? $", {summary.Missing} do not exist" : "")
                  + (summary.Changed > 0 ? $", {summary.Changed} changed since last time" : "")
                  + (summary.Skipped > 0
                      ? $". {summary.Skipped} not read: a page can only do {DnsStatusService.RefreshLimit} at a time, "
                        + "and the rest are the scheduled scan's work."
                      : ".");
        }
        catch (Exception ex)
        {
            outcome = $"Could not read DNS: {ex.Message}";
        }
        finally
        {
            _scanning = false;
        }

        // Reloaded first, because LoadAsync clears the message: what is shown
        // has to describe the readings now on screen.
        await LoadAsync();
        _scanMessage = outcome;
    }

    private void FilterPolicy(string? policy) => _policy = _policy == policy ? null : policy;

    /// <summary>
    /// A different client was chosen. A policy filter it cannot satisfy is
    /// dropped: pressed on "p=none" and then moved to a client whose domains
    /// all enforce, the table would be empty with no chip lit to say why.
    /// </summary>
    private void ClientChanged()
    {
        if (_policy is not null && InScope.All(r => r.Policy != _policy)) { _policy = null; }
    }

    private void ShowAllClients() => _client = "";

    private void ClearFilters()
    {
        _filter = "";
        _policy = null;
    }

    /// <summary>
    /// Orders by a column; pressing the one already chosen reverses it.
    /// </summary>
    /// <remarks>
    /// A column opens on the order somebody pressing it is asking for - see
    /// <see cref="DomainList.StartsDescending"/> - rather than always on the
    /// same side.
    /// </remarks>
    private void SortBy(DomainSort column)
    {
        if (_sort == column)
        {
            _descending = !_descending;
            return;
        }

        _sort = column;
        _descending = DomainList.StartsDescending(column);
    }

    private string? Aria(DomainSort column) => SortButton.AriaSort(_sort == column, _descending);

    private RenderFragment SortHeader(string label, DomainSort column) =>
        @<SortButton Label="@label" Active="@(_sort == column)" Descending="_descending" OnPress="() => SortBy(column)" />;

    /// <summary>
    /// Whether the client is worth printing under the domain: it has a name,
    /// it is a client rather than the waiting room, and it is not just the
    /// domain over again.
    /// </summary>
    private static bool NamesAClient(DomainTriage row) =>
        !string.IsNullOrWhiteSpace(row.ClientName)
        && !string.Equals(row.ClientName, row.Domain, StringComparison.OrdinalIgnoreCase);

    private static string Css(TriageLevel level) => level switch
    {
        TriageLevel.Urgent => "urgent",
        TriageLevel.Act => "act",
        TriageLevel.Watch => "watch",
        TriageLevel.OnTrack => "ontrack",
        _ => "fine",
    };

    private static string Label(TriageLevel level) => level switch
    {
        TriageLevel.Urgent => "Urgent",
        TriageLevel.Act => "Act",
        TriageLevel.Watch => "Watch",
        TriageLevel.OnTrack => "On track",
        _ => "Fine",
    };

    /// <summary>Not enforcing is the one to look at; enforcing is the goal, and a rollout in between is information.</summary>
    private static string PolicyCss(string policy) => policy switch
    {
        "reject" => "fine",
        "quarantine" => "ontrack",
        _ => "watch",
    };
}
