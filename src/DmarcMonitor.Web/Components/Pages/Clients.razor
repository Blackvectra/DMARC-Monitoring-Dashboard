@page "/clients"
@using DmarcMonitor.Core.Storage
@using DmarcMonitor.Core.Tenancy
@using DmarcMonitor.Web.Auth
@using DmarcMonitor.Web.Data
@inject OnboardingService Onboarding
@inject ReportStoreConnection Db
@inject OrgContext Org
@inject AuditLog Audit
@rendermode InteractiveServer

<PageTitle>Clients — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Clients</h1>
        <p class="sub">Reports arrive for domains before anybody gets round to onboarding them, so they
           are kept under Unassigned rather than refused. That makes Unassigned a worklist. Every domain
           belongs to one client, and every client to one organization.</p>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been imported.</p>
        <pre>dmarc init-db --db @Db.Path
dmarc import --from C:\dmarc-export</pre>
    </div>
}
else if (_clients is null)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else
{
    @if (_message is not null)
    {
        <section class="callout @(_messageIsError ? "urgent" : "fine")">
            <h2>@_message</h2>
        </section>
    }

    @if (_unassigned.Count > 0)
    {
        <section class="callout act">
            <h2>@_unassigned.Count domain(s) not assigned to a client</h2>
            <p>Reports are being stored for these, and nobody is being billed for them. They will not
               appear on a client's report until they are assigned.</p>
        </section>
    }

    @if (CanOperate)
    {
        <section>
            <h2>@(_unassigned.Count > 0 ? "Assign a domain" : "Move a domain")</h2>
            @* Every domain, not only the unfiled ones: a customer that changes
               hands, or a domain onboarded under the wrong name, has to be movable
               without a terminal. Unassigned ones come first, because that is the
               worklist. *@
            <div class="form-row">
                <select @bind="_assignDomain" aria-label="Domain">
                    <option value="">Choose a domain…</option>
                    @foreach (var d in _domains.OrderBy(d => d.ClientSlug == ReportStore.UnassignedClientSlug ? 0 : 1).ThenBy(d => d.Domain, StringComparer.Ordinal))
                    {
                        <option value="@d.Domain">@d.Domain @(d.ClientSlug == ReportStore.UnassignedClientSlug ? "(unassigned)" : $"— {d.ClientName}")</option>
                    }
                </select>
                <select @bind="_assignClient" aria-label="Client">
                    <option value="">Choose a client…</option>
                    @foreach (var c in Assignable)
                    {
                        <option value="@c.Slug">@(AcrossOrganizations ? $"{c.OrganizationName} / {c.Name}" : c.Name)</option>
                    }
                </select>
                <button class="primary" disabled="@(!CanAssign)" @onclick="AssignAsync">@(_unassigned.Count > 0 ? "Assign" : "Move")</button>
            </div>
            @if (!Assignable.Any())
            {
                <p class="sub">No clients yet. Add one below first.</p>
            }
            else if (AcrossOrganizations)
            {
                <p class="sub">Assigning a domain to a client in another organization moves it there, history and all.</p>
            }
        </section>

        <section>
            <h2>Add a client</h2>
            <div class="form-row">
                <input placeholder="Client name, e.g. Contoso Dental" @bind="_newName" @bind:event="oninput" />
                @if (_access is { IsMaster: true, Visible.Count: > 1 })
                {
                    @* A master looking across organizations has to say which one
                       the new client belongs to; anybody else has exactly one. *@
                    <select @bind="_newOrganization" aria-label="Organization">
                        @foreach (var o in _access.Visible)
                        {
                            <option value="@o.Slug">@o.Name</option>
                        }
                    </select>
                }
                <button class="primary" disabled="@string.IsNullOrWhiteSpace(_newName)" @onclick="AddAsync">Add</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_newName))
            {
                @* Shown before the click, because the slug ends up in report
                   filenames and cannot be changed afterwards. *@
                <p class="sub">Will be filed as <code>@ReportStore.Slugify(_newName)</code></p>
            }
        </section>
    }
    else
    {
        <p class="sub">Assigning domains and adding clients needs the operator role. You can read everything here.</p>
    }

    <section>
        <h2>Everyone</h2>
        @if (CanAdminister)
        {
            <p class="sub">A customer's own login: the members of the Entra group named against a client see that
               client and nothing else, read only. Guests in your directory work.</p>
        }
        <table class="triage">
            <thead>
                <tr>
                    @if (AcrossOrganizations) { <th>Organization</th> }
                    <th>Client</th>
                    <th>Slug</th>
                    <th class="num">Domains</th>
                    @* Every message ever stored, not the window the triage
                       list uses. Two pages showing "messages" with different
                       scopes and no labels is how somebody concludes one of
                       them is broken. *@
                    <th class="num">Messages (all time)</th>
                    @if (CanAdminister) { <th>Customer login group</th><th>Organization</th><th></th> }
                </tr>
            </thead>
            <tbody>
                @* Unassigned is shown only while it holds something. An empty
                   bucket listed among the customers reads as an eleventh
                   client that nobody can bill. *@
                @foreach (var c in _clients.Where(c => c.Slug != ReportStore.UnassignedClientSlug || c.Domains > 0))
                {
                    var unassigned = c.Slug == ReportStore.UnassignedClientSlug;
                    <tr class="@(unassigned && c.Domains > 0 ? "act" : "")">
                        @if (AcrossOrganizations) { <td class="muted">@c.OrganizationName</td> }
                        <td>
                            @if (CanAdminister && !unassigned)
                            {
                                @* The name is the thing with a typo in it.
                                   "Dakota Valley railRoad" was on every report
                                   that customer received, and could not be
                                   corrected anywhere in this product. *@
                                <input class="name-edit" aria-label="@($"Name for {c.Name}")"
                                       value="@_nameEdits.GetValueOrDefault(c.Slug, c.Name)"
                                       @onchange="e => _nameEdits[c.Slug] = e.Value?.ToString() ?? string.Empty" />
                            }
                            else
                            {
                                @c.Name
                            }
                        </td>
                        @* The slug is not editable and never will be: it is in
                           the filename of every report already sent. *@
                        <td><code>@c.Slug</code></td>
                        <td class="num">@c.Domains</td>
                        <td class="num">@c.Messages.ToString("N0")</td>
                        @if (CanAdminister)
                        {
                            <td>
                                @if (!unassigned)
                                {
                                    <input placeholder="Entra group object id" aria-label="@($"Customer login group for {c.Name}")"
                                           value="@_groupEdits.GetValueOrDefault(c.Slug, c.EntraGroupId ?? "")"
                                           @onchange="e => _groupEdits[c.Slug] = e.Value?.ToString() ?? string.Empty" />
                                }
                            </td>
                            <td>
                                @if (!unassigned && MoveTargets(c).Any())
                                {
                                    @* Everybody imports reports before they
                                       think about structure, so every customer
                                       starts in the default organization. This
                                       is the way out, and until now there was
                                       none short of deleting and recreating
                                       them - which burns the slug already on
                                       sent reports. *@
                                    <select aria-label="@($"Move {c.Name} to another organization")"
                                            @onchange="e => _moveTo[c.Slug] = e.Value?.ToString() ?? string.Empty">
                                        <option value="">Move to…</option>
                                        @foreach (var o in MoveTargets(c))
                                        {
                                            <option value="@o.Slug">@o.Name</option>
                                        }
                                    </select>
                                }
                            </td>
                            <td>
                                @if (!unassigned)
                                {
                                    <button disabled="@_busy" @onclick="() => SaveClientAsync(c)">Save</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private OrganizationAccess? _access;
    private IReadOnlyList<ReportStore.ClientSummary>? _clients;
    private IReadOnlyList<ReportStore.DomainSummary> _domains = [];
    private IReadOnlyList<string> _unassigned = [];
    private readonly Dictionary<string, string> _groupEdits = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _nameEdits = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _moveTo = new(StringComparer.Ordinal);
    private bool _busy;
    private string? _error;

    private string? _message;
    private bool _messageIsError;

    private string _newName = "";
    private string _newOrganization = "";
    private string _assignDomain = "";
    private string _assignClient = "";

    private bool AcrossOrganizations => _access is { IsMaster: true, Current: null, Visible.Count: > 1 };
    private bool CanOperate => _access is { CanOperate: true };
    private bool CanAdminister => _access is { CanAdminister: true };

    private IEnumerable<ReportStore.ClientSummary> Assignable =>
        (_clients ?? []).Where(c => c.Slug != ReportStore.UnassignedClientSlug);

    private bool CanAssign =>
        CanOperate && !string.IsNullOrWhiteSpace(_assignDomain) && !string.IsNullOrWhiteSpace(_assignClient);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        if (!Db.Exists) { _clients = []; return; }

        try
        {
            _access = await Org.GetAsync();
            var tenant = _access.TenantId;

            // A customer's own login has no business here. The sidebar link
            // is hidden for them, and the URL typed by hand listed every
            // client of the MSP - names, slugs, message totals - because
            // nothing on the page itself asked who was looking.
            if (_access.RestrictedClient is not null)
            {
                _clients = [];
                _domains = [];
                _unassigned = [];
                _error = "This page is for the provider. Your own domains are under Domain health.";
                return;
            }

            _clients = await Onboarding.GetClientsAsync(tenant);
            _domains = await Onboarding.GetDomainsAsync(tenant);
            _unassigned = await Onboarding.GetUnassignedDomainsAsync(tenant);

            if (string.IsNullOrEmpty(_newOrganization)) { _newOrganization = OrgContext.OrganizationFor(_access); }
        }
        catch (Exception ex)
        {
            _clients = [];
            _domains = [];
            _unassigned = [];
            _error = ex.Message;
        }
    }

    private async Task AddAsync()
    {
        // Checked here as well as in the markup: the handler runs on the
        // server, and a hidden form is not a permission.
        var name = _newName.Trim();
        if (name.Length == 0 || !CanOperate) { return; }

        try
        {
            var slug = await Onboarding.CreateClientAsync(name, _newOrganization);
            if (slug is null)
            {
                // Two reasons, two different fixes, so they are not merged
                // into one "could not add".
                var wanted = ReportStore.Slugify(name);
                Set(wanted.Length == 0
                    ? $"'{name}' has no letters or digits to build a name from."
                    : $"A client filed as '{wanted}' already exists.", isError: true);
            }
            else
            {
                Set($"Added {name}, filed as '{slug}'.", isError: false);
                await Audit.RecordAsync(_access?.Current?.Id, _access?.User ?? "", "client.added", $"{name} ({slug}) in {_newOrganization}");
                _newName = "";
            }
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }

        await LoadAsync();
    }

    private async Task AssignAsync()
    {
        if (!CanAssign) { return; }

        try
        {
            var outcome = await Onboarding.AssignAsync(_assignDomain, _assignClient, _access?.TenantId);
            Set(outcome switch
            {
                ReportStore.AssignOutcome.Assigned =>
                    $"{_assignDomain} is now filed under '{_assignClient}', along with everything already stored for it.",
                ReportStore.AssignOutcome.AlreadyAssigned =>
                    $"{_assignDomain} was already filed under '{_assignClient}'.",
                ReportStore.AssignOutcome.DomainNotFound =>
                    $"No reports have been stored for {_assignDomain}.",
                _ => $"No client filed as '{_assignClient}'.",
            }, isError: outcome is not (ReportStore.AssignOutcome.Assigned or ReportStore.AssignOutcome.AlreadyAssigned));

            if (outcome == ReportStore.AssignOutcome.Assigned)
            {
                await Audit.RecordAsync(_access?.Current?.Id, _access?.User ?? "", "domain.assigned", $"{_assignDomain} -> {_assignClient}");
            }

            _assignDomain = "";
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }

        await LoadAsync();
    }

    /// <summary>
    /// The organizations this client could move to: every one the signed-in
    /// person can see, except the one it is already in.
    /// </summary>
    /// <remarks>
    /// Empty for somebody who can see only one organization, and the control
    /// is not drawn at all then - a "Move to..." box with nothing in it is a
    /// promise the page cannot keep.
    /// </remarks>
    private IEnumerable<Organization> MoveTargets(ReportStore.ClientSummary c) =>
        (_access?.Visible ?? [])
            .Where(o => !o.Slug.Equals(c.OrganizationSlug, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Applies whatever changed on one row: the name, the customer login
    /// group, the organization, or any combination.
    /// </summary>
    /// <remarks>
    /// One button rather than three. Three would be three chances to change a
    /// name, not press the right Save, and lose it - and the row is short
    /// enough that a person reads it as one thing.
    ///
    /// The move goes last on purpose. It changes which organization the
    /// client answers to, and a rename applied afterwards would be scoped to
    /// the organization it has just left.
    /// </remarks>
    private async Task SaveClientAsync(ReportStore.ClientSummary c)
    {
        if (!CanAdminister || _busy) { return; }

        _busy = true;
        try
        {
            var changed = new List<string>();

            var name = _nameEdits.GetValueOrDefault(c.Slug, c.Name).Trim();
            if (name.Length > 0 && !name.Equals(c.Name, StringComparison.Ordinal))
            {
                if (await Onboarding.RenameClientAsync(c.Slug, name, _access?.TenantId))
                {
                    changed.Add($"renamed to {name}");
                    await Audit.RecordAsync(_access?.Current?.Id, _access?.User ?? "",
                        "client.rename", $"{c.Slug}: {c.Name} -> {name}");
                }
            }

            var group = _groupEdits.GetValueOrDefault(c.Slug, c.EntraGroupId ?? "").Trim();
            if (!string.Equals(group, c.EntraGroupId ?? "", StringComparison.OrdinalIgnoreCase)
                && await Onboarding.SetClientGroupAsync(c.Slug, group, _access?.TenantId))
            {
                changed.Add(group.Length == 0
                    ? "customer login cleared"
                    : $"customer login group {group} — they may need to sign out and back in");
                await Audit.RecordAsync(_access?.Current?.Id, _access?.User ?? "",
                    "client.login-group", $"{c.Slug}: {(group.Length == 0 ? "cleared" : group)}");
            }

            var to = _moveTo.GetValueOrDefault(c.Slug, "").Trim();
            if (to.Length > 0)
            {
                var outcome = await Onboarding.MoveClientAsync(c.Slug, to, _access?.TenantId);
                if (outcome == ReportStore.MoveOutcome.Moved)
                {
                    changed.Add($"moved to {to}, with its domains and history");
                    await Audit.RecordAsync(_access?.Current?.Id, _access?.User ?? "",
                        "client.move", $"{c.Slug}: {c.OrganizationSlug} -> {to}");
                }
                else
                {
                    Set(Explain(outcome, c, to), isError: true);
                    return;
                }
            }

            Set(changed.Count == 0 ? "Nothing changed." : $"{name}: {string.Join("; ", changed)}.",
                isError: false);
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }
        finally
        {
            _busy = false;
            _nameEdits.Clear();
            _moveTo.Clear();
        }

        await LoadAsync();
    }

    /// <summary>Why a move was refused, in terms of what to do about it.</summary>
    private static string Explain(ReportStore.MoveOutcome outcome, ReportStore.ClientSummary c, string to) =>
        outcome switch
        {
            ReportStore.MoveOutcome.SlugTaken =>
                $"{to} already has a client filed as '{c.Slug}'. Slugs are permanent because they are in "
                + "report filenames, so one of the two has to be renamed by somebody who knows which is which.",
            ReportStore.MoveOutcome.OrganizationNotFound => $"No organization called '{to}'.",
            ReportStore.MoveOutcome.ClientNotFound => $"No client filed as '{c.Slug}'.",
            ReportStore.MoveOutcome.AlreadyThere => $"{c.Name} is already in {to}.",
            ReportStore.MoveOutcome.NotMovable =>
                "Unassigned is a waiting room rather than a customer, and every organization has its own.",
            ReportStore.MoveOutcome.Ambiguous =>
                $"More than one organization has a client filed as '{c.Slug}'. Switch to the one this "
                + "client belongs to and move it from there.",
            _ => "The move did not happen.",
        };

    private async Task SaveGroupAsync(ReportStore.ClientSummary c)
    {
        if (!CanAdminister) { return; }

        try
        {
            var group = _groupEdits.GetValueOrDefault(c.Slug, c.EntraGroupId ?? "").Trim();
            var saved = await Onboarding.SetClientGroupAsync(c.Slug, group, _access?.TenantId);
            Set(!saved ? $"No client filed as '{c.Slug}'."
                : group.Length == 0 ? $"{c.Name}: customer login cleared."
                : $"{c.Name}: members of {group} now see this client only. They may need to sign out and back in.",
                isError: !saved);
            if (saved)
            {
                await Audit.RecordAsync(_access?.Current?.Id, _access?.User ?? "", "client.login-group",
                    $"{c.Slug}: {(group.Length == 0 ? "cleared" : group)}");
            }
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }

        await LoadAsync();
    }

    private void Set(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }
}
