@page "/clients"
@using DmarcMonitor.Core.Storage
@using DmarcMonitor.Core.Tenancy
@using DmarcMonitor.Web.Auth
@using DmarcMonitor.Web.Data
@inject OnboardingService Onboarding
@inject ReportStoreConnection Db
@inject OrgContext Org
@rendermode InteractiveServer

<PageTitle>Clients — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Clients</h1>
        <p class="sub">Reports arrive for domains before anybody gets round to onboarding them, so they
           are kept under Unassigned rather than refused. That makes Unassigned a worklist. Every domain
           belongs to one client, and every client to one organisation.</p>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been imported.</p>
        <pre>dmarc init-db --db @Db.Path
dmarc import --from C:\dmarc-export</pre>
    </div>
}
else if (_clients is null)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else
{
    @if (_message is not null)
    {
        <section class="callout @(_messageIsError ? "urgent" : "fine")">
            <h2>@_message</h2>
        </section>
    }

    @if (_unassigned.Count > 0)
    {
        <section class="callout act">
            <h2>@_unassigned.Count domain(s) not assigned to a client</h2>
            <p>Reports are being stored for these, and nobody is being billed for them. They will not
               appear on a client's report until they are assigned.</p>
        </section>
    }

    <section>
        <h2>@(_unassigned.Count > 0 ? "Assign a domain" : "Move a domain")</h2>
        @* Every domain, not only the unfiled ones: a customer that changes
           hands, or a domain onboarded under the wrong name, has to be movable
           without a terminal. Unassigned ones come first, because that is the
           worklist. *@
        <div class="form-row">
            <select @bind="_assignDomain" aria-label="Domain">
                <option value="">Choose a domain…</option>
                @foreach (var d in _domains.OrderBy(d => d.ClientSlug == ReportStore.UnassignedClientSlug ? 0 : 1).ThenBy(d => d.Domain, StringComparer.Ordinal))
                {
                    <option value="@d.Domain">@d.Domain @(d.ClientSlug == ReportStore.UnassignedClientSlug ? "(unassigned)" : $"— {d.ClientName}")</option>
                }
            </select>
            <select @bind="_assignClient" aria-label="Client">
                <option value="">Choose a client…</option>
                @foreach (var c in Assignable)
                {
                    <option value="@c.Slug">@(AcrossOrganisations ? $"{c.OrganisationName} / {c.Name}" : c.Name)</option>
                }
            </select>
            <button class="primary" disabled="@(!CanAssign)" @onclick="AssignAsync">@(_unassigned.Count > 0 ? "Assign" : "Move")</button>
        </div>
        @if (!Assignable.Any())
        {
            <p class="sub">No clients yet. Add one below first.</p>
        }
        else if (AcrossOrganisations)
        {
            <p class="sub">Assigning a domain to a client in another organisation moves it there, history and all.</p>
        }
    </section>

    <section>
        <h2>Add a client</h2>
        <div class="form-row">
            <input placeholder="Client name, e.g. Morton, ND" @bind="_newName" @bind:event="oninput" />
            @if (_access is { IsMaster: true, Visible.Count: > 1 })
            {
                @* A master looking across organisations has to say which one
                   the new client belongs to; anybody else has exactly one. *@
                <select @bind="_newOrganisation" aria-label="Organisation">
                    @foreach (var o in _access.Visible)
                    {
                        <option value="@o.Slug">@o.Name</option>
                    }
                </select>
            }
            <button class="primary" disabled="@string.IsNullOrWhiteSpace(_newName)" @onclick="AddAsync">Add</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_newName))
        {
            @* Shown before the click, because the slug ends up in report
               filenames and cannot be changed afterwards. *@
            <p class="sub">Will be filed as <code>@ReportStore.Slugify(_newName)</code></p>
        }
    </section>

    <section>
        <h2>Everyone</h2>
        <table class="triage">
            <thead>
                <tr>
                    @if (AcrossOrganisations) { <th>Organisation</th> }
                    <th>Client</th>
                    <th>Slug</th>
                    <th class="num">Domains</th>
                    @* Every message ever stored, not the window the triage
                       list uses. Two pages showing "messages" with different
                       scopes and no labels is how somebody concludes one of
                       them is broken. *@
                    <th class="num">Messages (all time)</th>
                </tr>
            </thead>
            <tbody>
                @* Unassigned is shown only while it holds something. An empty
                   bucket listed among the customers reads as an eleventh
                   client that nobody can bill. *@
                @foreach (var c in _clients.Where(c => c.Slug != ReportStore.UnassignedClientSlug || c.Domains > 0))
                {
                    var unassigned = c.Slug == ReportStore.UnassignedClientSlug;
                    <tr class="@(unassigned && c.Domains > 0 ? "act" : "")">
                        @if (AcrossOrganisations) { <td class="muted">@c.OrganisationName</td> }
                        <td>@c.Name</td>
                        <td><code>@c.Slug</code></td>
                        <td class="num">@c.Domains</td>
                        <td class="num">@c.Messages.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private OrganisationAccess? _access;
    private IReadOnlyList<ReportStore.ClientSummary>? _clients;
    private IReadOnlyList<ReportStore.DomainSummary> _domains = [];
    private IReadOnlyList<string> _unassigned = [];
    private string? _error;

    private string? _message;
    private bool _messageIsError;

    private string _newName = "";
    private string _newOrganisation = "";
    private string _assignDomain = "";
    private string _assignClient = "";

    private bool AcrossOrganisations => _access is { IsMaster: true, Current: null, Visible.Count: > 1 };

    private IEnumerable<ReportStore.ClientSummary> Assignable =>
        (_clients ?? []).Where(c => c.Slug != ReportStore.UnassignedClientSlug);

    private bool CanAssign =>
        !string.IsNullOrWhiteSpace(_assignDomain) && !string.IsNullOrWhiteSpace(_assignClient);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        if (!Db.Exists) { _clients = []; return; }

        try
        {
            _access = await Org.GetAsync();
            var tenant = _access.TenantId;

            _clients = await Onboarding.GetClientsAsync(tenant);
            _domains = await Onboarding.GetDomainsAsync(tenant);
            _unassigned = await Onboarding.GetUnassignedDomainsAsync(tenant);

            if (string.IsNullOrEmpty(_newOrganisation)) { _newOrganisation = OrgContext.OrganisationFor(_access); }
        }
        catch (Exception ex)
        {
            _clients = [];
            _domains = [];
            _unassigned = [];
            _error = ex.Message;
        }
    }

    private async Task AddAsync()
    {
        var name = _newName.Trim();
        if (name.Length == 0) { return; }

        try
        {
            var slug = await Onboarding.CreateClientAsync(name, _newOrganisation);
            if (slug is null)
            {
                // Two reasons, two different fixes, so they are not merged
                // into one "could not add".
                var wanted = ReportStore.Slugify(name);
                Set(wanted.Length == 0
                    ? $"'{name}' has no letters or digits to build a name from."
                    : $"A client filed as '{wanted}' already exists.", isError: true);
            }
            else
            {
                Set($"Added {name}, filed as '{slug}'.", isError: false);
                _newName = "";
            }
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }

        await LoadAsync();
    }

    private async Task AssignAsync()
    {
        if (!CanAssign) { return; }

        try
        {
            var outcome = await Onboarding.AssignAsync(_assignDomain, _assignClient, _access?.TenantId);
            Set(outcome switch
            {
                ReportStore.AssignOutcome.Assigned =>
                    $"{_assignDomain} is now filed under '{_assignClient}', along with everything already stored for it.",
                ReportStore.AssignOutcome.AlreadyAssigned =>
                    $"{_assignDomain} was already filed under '{_assignClient}'.",
                ReportStore.AssignOutcome.DomainNotFound =>
                    $"No reports have been stored for {_assignDomain}.",
                _ => $"No client filed as '{_assignClient}'.",
            }, isError: outcome is not (ReportStore.AssignOutcome.Assigned or ReportStore.AssignOutcome.AlreadyAssigned));

            _assignDomain = "";
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }

        await LoadAsync();
    }

    private void Set(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }
}
