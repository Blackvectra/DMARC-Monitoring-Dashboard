@page "/reports"
@using DmarcMonitor.Core.Reporting
@using DmarcMonitor.Web.Data
@using DmarcMonitor.Web.Auth
@inject ReportUiService ReportUi
@inject ReportStoreConnection Db
@inject OrgContext Org
@inject DmarcMonitor.Core.Tenancy.OrganizationStore Organizations
@inject DmarcMonitor.Core.Tenancy.AuditLog Audit
@rendermode InteractiveServer

<PageTitle>Reports — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Reports</h1>
        <p class="sub">The monthly report a client receives, as a PDF — the document you attach to an
           email, with this company's name on it and nothing of this server's.</p>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been imported.</p>
    </div>
}
else if (_clients is null)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else if (_clients.Count == 0)
{
    <div class="empty">
        <h2>No clients yet</h2>
        <p>Domains arrive under Unassigned. <a href="clients">Assign them to a client</a> and they can
           be reported on.</p>
    </div>
}
else
{
    <section>
        <div class="form-row">
            <select @bind="_slug" @bind:after="ClientChangedAsync">
                @foreach (var c in _clients)
                {
                    <option value="@c.Slug">@c.Name</option>
                }
            </select>
            <select @bind="_month" @bind:after="PreviewAsync">
                @foreach (var m in ReportUiService.RecentMonths())
                {
                    <option value="@m.Value">@m.Label</option>
                }
            </select>
            @* Not a link while the document would be signed "your IT provider".
               The warning below was there all along and did not stop anybody:
               a page that explains why the report is wrong and then offers a
               button to open it has told somebody what to ignore. *@
            @if (Named)
            {
                <a class="primary-link" href="@($"reports/download/{_slug}/{_month}")" target="_blank">Open PDF</a>
            }
            else
            {
                <span class="primary-link disabled" aria-disabled="true"
                      title="Set Reporting:ProviderName before a report can be opened.">Open PDF</span>
            }
        </div>
        @if (Named)
        {
            <p class="sub">Reported as “@(_preview?.ProviderName ?? ReportUi.ProviderName)”.</p>

            @* The long version stays, and is named for what it is for. It used
               to be the only version, under a note telling whoever sent it to
               turn the browser's headers and footers off in the print dialog
               first - a product asking somebody to remember something every
               month, and the month they forget, this server's address goes out
               across the foot of a document a customer is paying for. *@
            <p class="sub">
                The PDF is the document to send. For the full evidence tables on screen —
                every sender, every reporter, the remediation register —
                <a href="@($"reports/download/{_slug}/{_month}?format=html")" target="_blank">open the long
                version</a>.
            </p>
        }
        else
        {
            @* This is the page somebody opens a report from and sends it. A
               document going to a customer signed "your IT provider" is worth
               stopping for, not a footnote.

               And fixable here rather than somewhere else. Sending somebody to
               another page to find one field, with nothing to tell them which,
               is how a first run ends: the one thing the product is for is
               behind a setting nobody knew existed. It is two words and they
               are already looking at the place that needs them. *@
            <p class="sub warn-inline">
                Reports cannot be opened yet: they would be signed “@ReportUi.ProviderName”,
                literally. Name yourself and this unlocks.
            </p>
            <div class="form-row">
                <input placeholder="e.g. NRG TechServices" @bind="_provider" @bind:event="oninput"
                       aria-label="Your name on reports" />
                <button class="primary" disabled="@(_savingProvider || string.IsNullOrWhiteSpace(_provider))"
                        @onclick="SaveProviderAsync">Use this name</button>
            </div>
            <p class="sub">
                It goes on every report this organization sends, under the client's name: “prepared by
                @(string.IsNullOrWhiteSpace(_provider) ? "…" : _provider.Trim())”. Change it any time on
                <a href="settings">Configuration</a>.
            </p>
            @if (_providerError is not null)
            {
                <p class="sub bad">@_providerError</p>
            }
        }
    </section>

    @if (_previewError is not null)
    {
        @* Where the preview would have been, under pickers that still work:
           the next client or month chosen tries again. *@
        <div class="empty">
            <h2>Could not build that month</h2>
            <p>@_previewError</p>
        </div>
    }
    else if (_preview is not null)
    {
        @* The verdict decides the colour, not the message count. A client
           with one domain losing half its mail inside an estate averaging
           96.6% used to get a green box; see ClientReport.StrugglingDomains. *@
        <section class="callout @(_summary is { NeedsAttention: true } || _preview.Messages == 0 ? "act" : "fine")">
            <h2>@_summary?.Headline</h2>
            @foreach (var point in _summary?.Points ?? [])
            {
                <p>@point</p>
            }
        </section>

        <div class="figures">
            <div class="figure">
                <span class="figure-n">@_preview.Messages.ToString("N0")</span>
                <span class="figure-l">messages</span>
            </div>
            <div class="figure">
                @* Any one domain below the line, never the estate's average -
                   which is the arithmetic that hides a failing domain. *@
                <span class="figure-n @(_preview.Messages > 0 && _preview.StrugglingDomains.Count > 0 ? "bad" : "good")">
                    @(_preview.Messages > 0 ? $"{_preview.PassRate}%" : "—")
                </span>
                <span class="figure-l">authenticated</span>
            </div>
            <div class="figure">
                <span class="figure-n">@_preview.ImpersonatingSources.Count</span>
                <span class="figure-l">sending as them</span>
            </div>
            <div class="figure">
                <span class="figure-n">@_preview.MisconfiguredSources.Count</span>
                <span class="figure-l">own mail failing</span>
            </div>
        </div>
    }
    else if (_checked)
    {
        <div class="empty">
            <h2>Nothing stored for that month</h2>
            <p>A report would still be produced and would say so, which is worth sending: silence from a
               monitoring provider is indistinguishable from a provider that stopped.</p>
        </div>
    }
}

@code {
    private IReadOnlyList<(string Slug, string Name)>? _clients;
    private ClientReport? _preview;
    private ReportSummary? _summary;

    // The page failing to load: there is nothing to choose from, so it
    // replaces everything below the heading.
    private string? _error;

    // One client's month failing to build, which is not the same thing: the
    // pickers stay, and the next thing chosen clears it. See PreviewAsync.
    private string? _previewError;
    private bool _checked;
    private string? _tenant;

    private string _slug = "";

    /// <summary>
    /// Whether the report for the client on screen would carry a real
    /// provider name.
    /// </summary>
    /// <remarks>
    /// Read from the built report where there is one, because the
    /// organization's own name on the Configuration page beats the
    /// install-wide setting - so an install with a blank
    /// <c>Reporting:ProviderName</c> can still produce correctly signed
    /// reports for an organization that named itself. The configuration is
    /// only the fallback answer, for the instant before a preview exists.
    /// </remarks>
    private bool Named =>
        _preview is { } preview ? !preview.ProviderIsUnnamed : ReportUi.IsProviderNameSet;

    private string _provider = "";
    private bool _savingProvider;
    private string? _providerError;

    /// <summary>
    /// Names this organization on its reports, from the page that needs it.
    /// </summary>
    /// <remarks>
    /// Written to the organization rather than to appsettings.json: the app
    /// cannot edit its own configuration file, and on a multi-organization
    /// install the per-organization name is the right answer anyway - it is
    /// what NextLayerSec's reports say on an install NRG configured.
    /// </remarks>
    private async Task SaveProviderAsync()
    {
        var wanted = _provider.Trim();
        if (wanted.Length == 0) { return; }

        _savingProvider = true;
        _providerError = null;

        try
        {
            var access = await Org.GetAsync();

            // The name printed on every report the organization sends. The
            // form showed to anybody while the organization was unnamed, and
            // saved for anybody, so a customer's read-only login could sign
            // the MSP's reports with a name of their choosing.
            if (!access.CanAdminister || access.RestrictedClient is not null)
            {
                _providerError = "Only an administrator of this organization can set its name.";
                return;
            }

            var organization = access.Current
                ?? (await Organizations.ListAsync()).FirstOrDefault();

            if (organization is null)
            {
                _providerError = "No organization to name. Create one on Configuration first.";
                return;
            }

            await Organizations.SetBrandAsync(organization.Slug, organization.Brand with { ProviderName = wanted });
            await Audit.RecordAsync(access.TenantId, access.User, "organization.updated",
                $"{organization.Slug}: provider name set to {wanted} from the reports page");

            // Rebuilt rather than patched, so what unlocks the button is the
            // same thing the document will say.
            await PreviewAsync();
        }
        catch (Exception ex)
        {
            _providerError = ex.Message;
        }
        finally
        {
            _savingProvider = false;
        }
    }

    // Replaced as soon as a client is known, by the most recent month that
    // client has data for. This is only the value the control holds for the
    // instant before that.
    private string _month = ReportUiService.RecentMonths()[0].Value;

    protected override async Task OnInitializedAsync()
    {
        if (!Db.Exists) { _clients = []; return; }

        try
        {
            var access = await Org.GetAsync();
            _tenant = access.TenantId;

            // Unassigned is a worklist, not a customer; a report addressed to
            // it is a document nobody can send. A customer's own login sees
            // only their own.
            _clients = [.. (await ReportUi.GetClientsAsync(_tenant))
                .Where(c => c.Slug != DmarcMonitor.Core.Storage.ReportStore.UnassignedClientSlug)
                .Where(c => access.RestrictedClient is null || c.Slug.Equals(access.RestrictedClient, StringComparison.OrdinalIgnoreCase))];

            if (_clients.Count > 0)
            {
                _slug = _clients[0].Slug;
                await ClientChangedAsync();
            }
        }
        catch (Exception ex)
        {
            _clients = [];
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Opens the month picker on a month that has something in it.
    /// </summary>
    /// <remarks>
    /// The picker used to start at the last month that had ENDED, which on a
    /// three-week-old install is a month from before it existed. What an
    /// operator saw first was "Nothing stored for that month" against a
    /// database holding three weeks of reports - and a real report went to a
    /// customer saying exactly that and nothing else.
    ///
    /// Per client, not per install: two customers onboarded months apart
    /// have different newest months, and a default worked out from the whole
    /// database would be wrong for one of them.
    ///
    /// A client with no data at all keeps whatever the picker was showing.
    /// There is no better month to choose, and moving the control to no
    /// purpose is worse than leaving it.
    /// </remarks>
    private async Task ClientChangedAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(_slug)
                && await ReportUi.LatestMonthWithDataAsync(_slug, _tenant) is { } month
                && ReportUiService.RecentMonths().Any(m => m.Value == month))
            {
                _month = month;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Only which month to open on, which is no reason to fail the
            // pick: the picker keeps its month, and the preview below says
            // whether that one builds. Uncaught, it escaped the client
            // picker's handler and took the whole circuit down.
        }

        await PreviewAsync();
    }

    private async Task PreviewAsync()
    {
        _checked = false;
        _preview = null;
        _summary = null;
        _previewError = null;

        // Only a client this login was offered. The dropdown is filtered to
        // the customer's own client, but the value it posts back is whatever
        // the browser says it is, and a customer who edited the option in
        // devtools was previewing another client's month. The list built at
        // load is the authority, not the bound string.
        if (string.IsNullOrEmpty(_slug)
            || _clients is null
            || !_clients.Any(c => c.Slug.Equals(_slug, StringComparison.OrdinalIgnoreCase)))
        {
            _slug = "";
            return;
        }

        try
        {
            ReportUiService.TryParseMonth(_month, out var period);
            var report = await ReportUi.BuildAsync(_slug, period, _tenant);

            // A month with no data still produces a report; the preview just
            // has nothing to show, which is a different thing from failing.
            if (report is { Messages: > 0 })
            {
                _preview = report;
                _summary = ReportNarrative.Summarize(report);
            }
        }
        catch (Exception ex)
        {
            // Said where the preview goes, and cleared by the next attempt.
            // It went into _error, which replaces the whole page - pickers
            // included - with "Could not read the database", and nothing ever
            // cleared it: the controls that would have tried again were the
            // ones it had taken away. One month that would not build left the
            // page stuck until it was reloaded.
            _previewError = ex.Message;
        }
        finally
        {
            _checked = true;
        }
    }
}
