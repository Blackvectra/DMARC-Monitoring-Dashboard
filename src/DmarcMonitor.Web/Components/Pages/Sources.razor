@page "/sources"
@using DmarcMonitor.Core.Intelligence
@using DmarcMonitor.Web.Data
@inject CorrelationService Correlation
@inject ReportStoreConnection Db
@rendermode InteractiveServer

<PageTitle>Sources — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Failing sources</h1>
        <p class="sub">Everything sending as a client domain without authenticating, ranked by how many
           clients it is hitting. A source against one domain is noise; the same source against three
           unrelated businesses is somebody running a campaign.</p>
    </div>
    <div class="head-actions">
        <label>
            Window
            <select @bind="_days" @bind:after="LoadAsync">
                <option value="7">7 days</option>
                <option value="30">30 days</option>
                <option value="90">90 days</option>
            </select>
        </label>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been ingested.</p>
    </div>
}
else if (_rows is null)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="empty">
        <h2>Nothing failing</h2>
        <p>No source failed authentication in this window, ignoring forwarders and mailing lists.</p>
    </div>
}
else
{
    @if (_crossClient.Count > 0)
    {
        <section class="callout urgent">
            <h2>@_crossClient.Count source(s) hitting more than one client</h2>
            <p>
                Only a platform watching several clients can see this. A single-tenant tool shows each
                domain owner their own reports and never sees the other company's data, so it cannot
                notice the same source working through several businesses.
            </p>
        </section>
    }

    <table class="triage">
        <thead>
            <tr>
                <th></th>
                <th>Source</th>
                <th class="num">Clients</th>
                <th class="num">Failed</th>
                <th>Seen against</th>
                <th>What it looks like</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr class="@Css(row.Verdict)">
                    <td><span class="pip @Css(row.Verdict)"></span></td>
                    <td><code>@row.SourceIp</code></td>
                    <td class="num">
                        @if (row.IsCrossClient)
                        {
                            <strong class="bad">@row.ClientCount</strong>
                        }
                        else
                        {
                            <span class="muted">@row.ClientCount</span>
                        }
                    </td>
                    <td class="num">@row.FailedMessages.ToString("N0")</td>
                    <td class="muted">@string.Join(", ", row.Domains)</td>
                    <td>@Explain(row)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<FailingSource>? _rows;
    private IReadOnlyList<FailingSource> _crossClient = [];
    private string? _error;
    private int _days = 30;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        if (!Db.Exists) { _rows = Array.Empty<FailingSource>(); return; }

        try
        {
            _rows = await Correlation.GetFailingSourcesAsync(_days);
            _crossClient = [.. _rows.Where(r => r.IsCrossClient)];
        }
        catch (Exception ex)
        {
            _rows = Array.Empty<FailingSource>();
            _crossClient = [];
            _error = ex.Message;
        }
    }

    private static string Css(SourceVerdict verdict) => verdict switch
    {
        SourceVerdict.CrossClientImpersonation => "urgent",
        SourceVerdict.Unauthenticated => "act",
        _ => "watch",
    };

    /// <summary>
    /// Deliberately cautious wording. Calling a client's own marketing
    /// platform an attacker is how an operator blocks their own invoices.
    /// </summary>
    private static string Explain(FailingSource row) => row.Verdict switch
    {
        SourceVerdict.CrossClientImpersonation =>
            $"Authenticated nothing, against {row.ClientCount} unrelated clients. "
          + "One domain would be noise; several is somebody working through a list.",

        SourceVerdict.Unauthenticated =>
            "Authenticated nothing. Either a service nobody recorded, or somebody sending as this domain.",

        // A source that has passed but names no other domain is one of the
        // client's own sending paths breaking in transit, not a third party
        // signing as itself. Without this branch the sentence reads
        // "Authenticated for  rather than the domain it sends as".
        _ when row.AuthenticatedFor.Count == 0 =>
            $"Has sent authenticated mail for all {row.DomainCount} of these domains, so it is one of their "
          + "own sending paths. These failures are signatures broken in transit, not somebody sending as them.",

        _ =>
            $"Authenticated for {string.Join(", ", row.AuthenticatedFor)} rather than the domain it sends as. "
          + "Almost always a real service set up with the provider's own domain, not an attack.",
    };
}
