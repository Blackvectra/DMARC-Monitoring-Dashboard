@page "/"
@* The sidebar calls this page Triage, so /triage is the address somebody
   types or bookmarks. Without this it was one of the URLs that returned a
   blank page. *@
@page "/triage"
@using DmarcMonitor.Core.Charting
@using DmarcMonitor.Core.Reporting
@using DmarcMonitor.Core.Rollout
@using DmarcMonitor.Core.Storage
@using DmarcMonitor.Core.Tenancy
@using DmarcMonitor.Web.Auth
@using DmarcMonitor.Web.Components.Charts
@using DmarcMonitor.Web.Data
@inject TriageService Triage
@inject TimeSeriesService Series
@inject ReportStoreConnection Db
@inject OrgContext Org
@inject OnboardingService Onboarding
@inject DnsStatusService Dns
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Triage — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Dashboard</h1>
        <p class="sub">Every domain, worst first. Not an average — an average across a whole book of
           domains hides the one that is broken.</p>
    </div>
    <div class="head-actions">
        @* One client at a time, when there is more than one to choose from.
           The whole page follows it: the dial, the chart, the rows. An MSP is
           asked "how is Morton doing", and the answer must not be the estate. *@
        @if (_clients.Count > 1 && _access?.RestrictedClient is null)
        {
            <label>
                Client
                <select @bind="_client" @bind:after="ClientChangedAsync" aria-label="Client">
                    <option value="">All clients</option>
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Slug">@c.Name</option>
                    }
                </select>
            </label>
        }
        <label>
            Window
            <select @bind="_days" @bind:after="ClientChangedAsync">
                <option value="7">7 days</option>
                <option value="14">14 days</option>
                <option value="30">30 days</option>
            </select>
        </label>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been ingested. Create the database and run an ingest:</p>
        <pre>dmarc init-db --db @Db.Path
dmarc ingest --mailbox DMARC@@nrgtechservices.com --fallback DMARC@@nrgtechservices.com --dry-run</pre>
        <p class="muted">Looking for: <code>@System.IO.Path.GetFullPath(Db.Path)</code></p>
    </div>
}
else if (_rows is null)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not read the database</h2>
        <p>@_error</p>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="empty">
        <h2>No domains yet</h2>
        <p>The database exists but holds no domains. Run an ingest once reports have arrived.</p>
    </div>
}
else
{
    @* What the whole book of domains has been doing, before any of the rows.
       A table of eighteen totals cannot show that the estate lost a third of
       its volume on Tuesday; this can. *@
    @*
        The overview, read left to right: what the mail was, how many domains
        are actually sending, and which services are carrying it. Four panels
        across the top rather than four cards down the page, so the shape of
        the estate is one glance rather than a scroll.
    *@
    @* Three figures, then the checks, then where the mail came from. The
       order is the order somebody asks the questions in: how are we doing,
       why, and who is doing it. *@
    <section class="scorecards">
        <div class="score-card">
            <p class="score-label">Security score</p>
            <p class="score-n @ScoreClass">@(_score.Known ? _score.Score.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")<span class="score-unit">@(_score.Known ? "/100" : "")</span></p>
            <p class="score-band @ScoreClass">@(_score.Known ? _score.Band : "Not scored")</p>
            @* Never a bare number. Every product in this market puts a score
               at the top of a dashboard and none of them says what it is
               made of, which makes it worth nothing to the person reading. *@
            <p class="score-sub">@_score.Weakest</p>
            @if (_score.Unassessed.Length > 0)
            {
                @* Said out loud rather than scored as a failure. The two are
                   not the same thing and the page must not blame a customer
                   for a reading nobody took. *@
                <p class="score-sub">@_score.Unassessed <a href="/domains">Read DNS</a></p>
            }
        </div>

        <div class="score-card">
            <p class="score-label">Total email volume</p>
            <p class="score-n">@_rates.Messages.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</p>
            <p class="score-sub">messages reported in the last @_days days@(_breakdown is { Total: > 0 } ? $", across {_active} sending domain(s)" : "")</p>
        </div>

        <div class="score-card">
            <p class="score-label">DMARC compliance rate</p>
            <p class="score-n @RateClass(_rates.DmarcRate)">@Pct(_rates.DmarcRate)</p>
            <p class="score-sub">
                @if (_rates.HasMail)
                {
                    @($"{_rates.DmarcPass:N0} of {_rates.Messages:N0} messages authenticated and aligned")
                }
                else
                {
                    @("No mail reported in this window.")
                }
            </p>
        </div>
    </section>

    <section class="overview two">
        <div class="panel">
            <h2 class="panel-h">Authentication results, last @_days days</h2>
            @if (_rates.HasMail)
            {
                @* SPF and DKIM are what the checks said; DMARC is what the
                   checks said AND whether they were about the domain in the
                   From line a person reads. The gap between them is the
                   finding, which is why they are one panel and not three. *@
                <div class="authrow">
                    @foreach (var (label, rate, note) in Checks())
                    {
                        <div class="auth">
                            <div class="auth-top">
                                <span class="auth-label">@label</span>
                                <span class="auth-pct @RateClass(rate)">@Pct(rate)</span>
                            </div>
                            <div class="auth-bar"><span class="@RateClass(rate)" style="width:@Chart.Percent(rate)"></span></div>
                            <p class="auth-note">@note</p>
                        </div>
                    }
                </div>

                @if (_rates.DmarcRate < Math.Max(_rates.SpfRate, _rates.DkimRate) - 20)
                {
                    <p class="auth-gap">
                        Mail is passing its checks and failing DMARC, which means the checks are
                        about a different domain from the one recipients see.
                        <a href="/sources">Which senders</a>
                    </p>
                }
            }
            else
            {
                <p class="muted">No mail reported in this window.</p>
            }
        </div>

        <div class="panel">
            <h2 class="panel-h">Outbound email overview</h2>
            @if (_breakdown is { Total: > 0 })
            {
                <Gauge Slices="@Volume()" Bare="true" />
                <ul class="outbound">
                    <li><span class="dot fine"></span> <b>DMARC capable</b> — authenticated and aligned, delivered as you intended</li>
                    <li><span class="dot watch"></span> <b>Forwarded</b> — the receiver broke the signature itself and said so</li>
                    <li><span class="dot urgent"></span> <b>Threats / unknown</b> — proved nothing, and nothing explains it</li>
                </ul>
            }
            else
            {
                <p class="muted">No mail reported in this window.</p>
            }
        </div>
    </section>

    <section class="overview two">
        <div class="panel">
            <h2 class="panel-h">Top sending sources</h2>
            @if (_hosts.Count > 0)
            {
                <table class="mini">
                    <thead>
                        <tr><th>Source</th><th class="num">Volume</th><th class="num">DMARC</th><th class="num">SPF</th><th class="num">DKIM</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var h in _hosts)
                        {
                            <tr>
                                <td>
                                    @* The name if there is one. Nobody
                                       recognizes an address. *@
                                    @if (h.IsNamed)
                                    {
                                        <a href="/sources/@h.SourceIp"><span class="src-name">@h.ReverseName</span></a>
                                        <span class="src-ip">@h.SourceIp</span>
                                    }
                                    else
                                    {
                                        <a href="/sources/@h.SourceIp"><code>@h.SourceIp</code></a>
                                    }
                                </td>
                                <td class="num">@h.Messages.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td class="num @RateClass(h.DmarcRate)">@Pct(h.DmarcRate)</td>
                                <td class="num">@Pct(h.SpfRate)</td>
                                <td class="num">@Pct(h.DkimRate)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="muted">No sending sources in this window.</p>
            }
        </div>

        <div class="panel">
            <h2 class="panel-h">Top threat / unknown / unaligned sources</h2>
            @if (_threats.Count > 0)
            {
                <table class="mini">
                    <thead>
                        <tr><th>Source</th><th>Sent as</th><th class="num">Messages</th><th>Also seen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _threats)
                        {
                            <tr>
                                <td>
                                    @if (t.IsNamed)
                                    {
                                        <a href="/sources/@t.SourceIp"><span class="src-name">@t.ReverseName</span></a>
                                        <span class="src-ip">@t.SourceIp</span>
                                    }
                                    else
                                    {
                                        <a href="/sources/@t.SourceIp"><code>@t.SourceIp</code></a>
                                    }
                                </td>
                                <td><code>@t.Domain</code></td>
                                <td class="num">@t.Messages.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                @* One customer's nuisance against several is
                                   a campaign, and that is worth telling the
                                   rest of the book about. *@
                                <td>@(t.OtherClients > 0 ? $"{t.OtherClients} other client(s)" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="panel-sub">
                    Never authenticated for the domain in this window. A source that passes even
                    once is your own mail path and is not listed here.
                </p>
            }
            else
            {
                <p class="muted">Nothing sent as these domains without authenticating. That is the good answer.</p>
            }
        </div>
    </section>

    <section class="overview two">
        <div class="panel">
            <h2 class="panel-h">Sending services, by the domain they authenticate for</h2>
            <SourceRates Sources="_sources" NotShown="@Math.Max(0, _sourceCount - _sources.Count)" />
        </div>

        <div class="panel-stack">
            <div class="panel panel-figure">
                <h2 class="panel-h">Active domains</h2>
                <p class="panel-n good">@_active</p>
                <p class="panel-sub">sent mail in this window</p>
            </div>

            <div class="panel panel-figure">
                <h2 class="panel-h">Inactive domains</h2>
                <p class="panel-n">@_inactive</p>
                @* Not the same as safe. A domain nobody sends as is one whose
                   DMARC record nobody is watching. *@
                <p class="panel-sub">no mail seen — still worth a policy</p>
            </div>
        </div>
    </section>

    @if (_series is not null && _series.Count > 0)
    {
        <VolumeChart Points="_series" Caption="@($"{Subject}, last {_days} days")" />

        <div class="chart">
            <figcaption>Where @(string.IsNullOrEmpty(_client) ? "this estate" : "this client") stands</figcaption>
            <ProportionBar Slices="@Severity()" Empty="No domains yet." />
        </div>
    }

    @* The counts were already here and were decoration: they said four
       domains were losing mail and gave no way to see only those four. A
       severity is the first thing anybody filters by, so it is the filter. *@
    <div class="counts">
        <button type="button" class="count @(_level is null ? "on" : "")"
                @onclick="() => Filter(null)">@Scoped.Count all</button>
        @foreach (var level in new[] { TriageLevel.Urgent, TriageLevel.Act, TriageLevel.Watch, TriageLevel.OnTrack, TriageLevel.Fine })
        {
            var n = Scoped.Count(r => r.Level == level);
            @if (n > 0)
            {
                var chosen = _level == level;
                <button type="button" class="count @Css(level) @(chosen ? "on" : "")"
                        aria-pressed="@chosen.ToString().ToLowerInvariant()"
                        @onclick="() => Filter(level)">@n @Label(level)</button>
            }
        }

        <input class="find" type="search" placeholder="Find a domain or client"
               aria-label="Find a domain or client"
               @bind="_find" @bind:event="oninput" @bind:after="Remember" />
    </div>

    var shown = Shown();

    @if (shown.Count == 0)
    {
        @* A filter that matches nothing has to say so. An empty table under a
           search box reads as "no domains", which is not what happened. *@
        <p class="muted">
            Nothing matches @(_level is null ? "" : $"\"{Label(_level.Value)}\"")@(_level is not null && _find.Length > 0 ? " and " : "")@(_find.Length > 0 ? $"\"{_find}\"" : "").
            <button class="linkish" @onclick="ClearFilters">Show all @Scoped.Count</button>
        </p>
    }
    else
    {
    <div class="table-scroll">
    <table class="triage">
        <thead>
            <tr>
                <th></th>
                @* Domain and what to do about it share a cell.

                   They used to be the second and the ninth of nine columns,
                   in a table wide enough to scroll sideways - so the sentence
                   telling an operator what to do sat eight columns from the
                   domain it was about, and a screenshot of that column alone
                   was eight rows of advice with nothing saying which domain
                   any of it belonged to. Three of them read "Quarantining
                   with nothing failing. Ready to move to p=reject." and were
                   indistinguishable.

                   Stacking them drops the table from nine columns to six,
                   which is also what stops it scrolling. *@
                <th>Domain</th>
                @if (AcrossOrganizations) { <th>Organization</th> }
                <th>Client</th>
                <th>Policy</th>
                <th class="num">Messages</th>
                <th class="num">Passing</th>
                <th class="spark-col">Trend</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in shown)
            {
                <tr class="@Css(row.Level)">
                    <td><span class="pip @Css(row.Level)" title="@Label(row.Level)"></span></td>
                    <td class="domain-cell">
                        <a href="@($"domains/{Uri.EscapeDataString(row.Domain)}")">@row.Domain</a>
                        @if (!string.IsNullOrWhiteSpace(row.Headline))
                        {
                            <span class="needs-doing">@row.Headline</span>
                        }
                    </td>
                    @if (AcrossOrganizations) { <td class="muted">@row.Organization</td> }
                    @* Onboarding by domain name makes these identical for most
                       rows, and a column repeating the one beside it eighteen
                       times is noise in the place the eye scans first. The
                       column stays, because it earns itself the moment a
                       client has more than one domain. *@
                    <td class="muted">
                        @(string.Equals(row.ClientName, row.Domain, StringComparison.OrdinalIgnoreCase)
                            ? "—" : row.ClientName)
                    </td>
                    <td><code>p=@row.Policy</code></td>
                    <td class="num">@row.Messages.ToString("N0")</td>
                    <td class="num">
                        @if (row.Messages > 0)
                        {
                            <span class="@(row.PassRate < 95 ? "bad" : "good")">@row.PassRate%</span>
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                    <td class="spark-col">
                        @* The column that makes eighteen rows comparable at a
                           glance: which domains are steady, which are growing,
                           which fell off a cliff last Tuesday. *@
                        @if (_sparks.TryGetValue(row.Domain, out var spark))
                        {
                            <Sparkline Points="spark" />
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (shown.Count < Scoped.Count)
    {
        <p class="sub">
            Showing @shown.Count of @Scoped.Count.
            <button class="linkish" @onclick="ClearFilters">Show all</button>
        </p>
    }
    }
}

@code {
    private OrganizationAccess? _access;
    private IReadOnlyList<ReportStore.ClientSummary> _clients = [];
    private IReadOnlyList<DomainTriage>? _rows;
    private IReadOnlyList<DayPoint>? _series;
    private VolumeBreakdown? _breakdown;
    private IReadOnlyList<SourceCompliance> _sources = [];
    private int _sourceCount;
    private AuthenticationRates _rates = new();
    private IReadOnlyList<SendingHost> _hosts = [];
    private IReadOnlyList<ThreatSource> _threats = [];
    private PostureScore _score = new();
    private int _active;
    private int _inactive;
    private IReadOnlyDictionary<string, IReadOnlyList<DayPoint>> _sparks =
        new Dictionary<string, IReadOnlyList<DayPoint>>();
    private string? _error;
    private int _days = 14;
    private string _client = "";

    private TriageLevel? _level;
    private string _find = "";

    /// <summary>The rows within the chosen client, before severity and search.</summary>
    private IReadOnlyList<DomainTriage> Scoped =>
        _rows is null ? []
        : string.IsNullOrEmpty(_client) ? _rows
        : [.. _rows.Where(r => r.ClientSlug.Equals(_client, StringComparison.OrdinalIgnoreCase))];

    /// <summary>A master looking at every organization at once needs to be told which is which.</summary>
    private bool AcrossOrganizations => _access is { IsMaster: true, Current: null, Visible.Count: > 1 };

    private string Subject =>
        !string.IsNullOrEmpty(_client) ? _clients.FirstOrDefault(c => c.Slug == _client)?.Name ?? "This client"
        : _access?.Current?.Name ?? "All domains";

    /// <summary>
    /// The view somebody was last looking at, carried in the address.
    /// </summary>
    /// <remarks>
    /// Working through one customer's domains meant retyping the filter every
    /// time: open a domain, press Back, and the page was showing all
    /// seventeen again. Held in the query string rather than in a field, so
    /// the scoped view survives navigating away and back, survives a refresh,
    /// and can be sent to somebody - "here is the one I mean" is a link now.
    ///
    /// Read once, on the first render. Every later change writes the address
    /// with replace: true, which updates the bar without adding a history
    /// entry, so Back leaves the page rather than stepping through every
    /// letter somebody typed into the search box.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "client")] private string? FromQueryClient { get; set; }

    [SupplyParameterFromQuery(Name = "find")] private string? FromQueryFind { get; set; }

    [SupplyParameterFromQuery(Name = "level")] private string? FromQueryLevel { get; set; }

    [SupplyParameterFromQuery(Name = "days")] private int? FromQueryDays { get; set; }

    protected override Task OnInitializedAsync()
    {
        _client = FromQueryClient ?? "";
        _find = FromQueryFind ?? "";

        // Only the windows the control offers. A hand-typed days=900 would
        // otherwise leave the select showing one thing and the page showing
        // another.
        if (FromQueryDays is 7 or 14 or 30 or 90) { _days = FromQueryDays.Value; }

        _level = Enum.TryParse<TriageLevel>(FromQueryLevel, ignoreCase: true, out var level) ? level : null;

        return LoadAsync();
    }

    private async Task ClientChangedAsync()
    {
        Remember();
        await LoadAsync();
    }

    /// <summary>
    /// Writes the current view into the address bar.
    /// </summary>
    /// <remarks>
    /// Nulls rather than empty strings, because
    /// GetUriWithQueryParameters drops a null and keeps an empty one - and a
    /// URL trailing "?client=&amp;find=&amp;level=" is noise on the link
    /// somebody is about to paste into a ticket.
    /// </remarks>
    private void Remember() => Nav.NavigateTo(
        Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["client"] = string.IsNullOrEmpty(_client) ? null : _client,
            ["find"] = string.IsNullOrWhiteSpace(_find) ? null : _find.Trim(),
            ["level"] = _level?.ToString().ToLowerInvariant(),
            ["days"] = _days == 14 ? null : _days,
        }),
        replace: true);

    /// <summary>
    /// Everything sent as these domains, split by what it turned out to be.
    /// </summary>
    /// <remarks>
    /// Worst last, so the dial reads left to right from the mail that is fine
    /// to the mail that is not, matching the ordering of every other list in
    /// the product.
    /// </remarks>
    private IReadOnlyList<Slice> Volume() =>
        _breakdown is null
            ? []
            :
            [
                new Slice("authenticated", _breakdown.Authenticated, "fine"),
                new Slice("forwarded or overridden", _breakdown.Overridden, "watch"),
                new Slice("unauthenticated", _breakdown.Unauthenticated, "urgent"),
            ];

    /// <summary>
    /// The three checks, in the order they are worth reading.
    /// </summary>
    /// <remarks>
    /// DMARC last and not first, although it is the one that matters, because
    /// the note under it only makes sense once the two above have been read.
    /// </remarks>
    private IReadOnlyList<(string Label, double Rate, string Note)> Checks() =>
    [
        ("SPF", _rates.SpfRate, "the sending server was authorized by the envelope domain"),
        ("DKIM", _rates.DkimRate, "the signature verified"),
        ("DMARC", _rates.DmarcRate, "one of those passed AND matched the domain recipients see"),
    ];

    /// <summary>
    /// A percentage written the same way everywhere, and invariantly.
    /// </summary>
    /// <remarks>
    /// Invariant because a machine whose locale uses a comma would print
    /// "98,4%", which is not wrong so much as it is a different number to a
    /// reader who does not know the locale. See Chart.Percent for the same
    /// rule applied to CSS widths, where the consequence is worse.
    /// </remarks>
    private static string Pct(double rate) =>
        rate.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    /// <summary>
    /// The colour of a rate, on the same thresholds the report uses.
    /// </summary>
    /// <remarks>
    /// 95 is where a client report stops calling a domain healthy, so a
    /// dashboard that turned green at 90 would be disagreeing with the
    /// document sent to the customer.
    /// </remarks>
    private static string RateClass(double rate) => rate switch
    {
        >= ClientReport.HealthyPassRate => "fine",
        >= 80 => "watch",
        _ => "urgent",
    };

    private string ScoreClass => !_score.Known ? "" : _score.Score switch
    {
        >= 90 => "fine",
        >= 70 => "ontrack",
        >= 45 => "watch",
        _ => "urgent",
    };

    /// <summary>The estate split by how much attention each domain needs.</summary>
    /// <remarks>
    /// Ordered worst first, matching the table under it and the ordering used
    /// everywhere else: a bar that runs green-to-red in one place and
    /// red-to-green in another is read wrongly in both.
    /// </remarks>
    private IReadOnlyList<Slice> Severity()
    {
        var rows = Scoped;
        return
        [
            new Slice("losing mail", rows.Count(r => r.Level == TriageLevel.Urgent), "urgent"),
            new Slice("needs work", rows.Count(r => r.Level == TriageLevel.Act), "act"),
            new Slice("worth a look", rows.Count(r => r.Level == TriageLevel.Watch), "watch"),
            new Slice("rollout on track", rows.Count(r => r.Level == TriageLevel.OnTrack), "ontrack"),
            new Slice("fine", rows.Count(r => r.Level == TriageLevel.Fine), "fine"),
        ];
    }

    /// <summary>
    /// The rows after the client, the severity filter and the search box.
    /// </summary>
    /// <remarks>
    /// Ordering is left exactly as the triage service returned it. Worst first
    /// is the whole point of the page, and re-sorting a filtered view by
    /// anything else would quietly change what "the top row" means.
    /// </remarks>
    private IReadOnlyList<DomainTriage> Shown()
    {
        var rows = _level is null ? Scoped : [.. Scoped.Where(r => r.Level == _level)];

        var find = _find.Trim();
        if (find.Length == 0) { return rows; }

        // Client as well as domain: an operator who has just been telephoned
        // knows the customer's name, not which of their four domains it is.
        return
        [
            .. rows.Where(r =>
                r.Domain.Contains(find, StringComparison.OrdinalIgnoreCase)
                || r.ClientName.Contains(find, StringComparison.OrdinalIgnoreCase)),
        ];
    }

    /// <summary>Clicking the chosen severity again clears it, as a toggle.</summary>
    private void Filter(TriageLevel? level)
    {
        _level = _level == level ? null : level;
        Remember();
    }

    private void ClearFilters()
    {
        _level = null;
        _find = "";
        Remember();
    }

    private async Task LoadAsync()
    {
        _error = null;
        if (!Db.Exists) { _rows = Array.Empty<DomainTriage>(); return; }

        try
        {
            // The scope first, before anything is read: every query below
            // carries it, and a page that read first and scoped afterwards
            // would have already fetched what it must not show.
            _access = await Org.GetAsync();
            var tenant = _access.TenantId;

            // Unassigned is only a client worth choosing while it holds
            // something; empty, it is an eleventh customer nobody can bill.
            _clients = [.. (await Onboarding.GetClientsAsync(tenant))
                .Where(c => c.Slug != ReportStore.UnassignedClientSlug || c.Domains > 0)];
            if (!string.IsNullOrEmpty(_client) && _clients.All(c => c.Slug != _client)) { _client = ""; }

            // A customer's own login is confined to their client, whatever
            // the picker would have said.
            if (_access.RestrictedClient is { } only) { _client = only; }

            _rows = await Triage.GetAsync(_days, tenant, string.IsNullOrEmpty(_client) ? null : _client);
        }
        catch (Exception ex)
        {
            // Rendering an empty table for a broken database would read as
            // "nothing is wrong", which is the opposite of the truth.
            _rows = Array.Empty<DomainTriage>();
            _error = ex.Message;
            _series = null;
            return;
        }

        try
        {
            var tenant = _access.TenantId;
            var client = string.IsNullOrEmpty(_client) ? null : _client;

            _series = await Series.EstateAsync(_days, tenant, client);
            _sparks = await Series.PerDomainAsync(_days, tenant, client);
            _breakdown = await Series.BreakdownAsync(days: _days, tenantId: tenant, clientSlug: client);

            // One more than the panel shows, so "N more not shown" can be
            // honest about whether there are any rather than guessing.
            const int shown = 6;
            var sources = await Series.SourcesAsync(days: _days, top: shown + 1, tenantId: tenant, clientSlug: client);
            _sourceCount = sources.Count;
            _sources = [.. sources.Take(shown)];

            (_active, _inactive) = await Series.DomainActivityAsync(_days, tenant, client);

            _rates = await Series.RatesAsync(days: _days, tenantId: tenant, clientSlug: client);
            _hosts = await Series.HostsAsync(days: _days, top: 8, tenantId: tenant, clientSlug: client);
            _threats = await Series.ThreatsAsync(days: _days, top: 8, tenantId: tenant, clientSlug: client);

            // The transport half of the score comes from what each domain
            // actually serves, which is a DNS reading rather than anything in
            // the reports. Where nothing has read DNS yet it counts as zero -
            // not knowing is not the same as enforcing, and scoring it as
            // enforcing would be the dashboard flattering an install that has
            // never looked.
            var dns = await Dns.GetAsync(tenant, client);

            // Scored from what is already on the page rather than from a
            // second pass over the data, so the number at the top and the
            // panels under it cannot disagree.
            var scoped = Scoped;
            _score = PostureScore.For(
                enforcing: scoped.Count(r => r.Policy is "reject" or "quarantine"),
                domains: scoped.Count,
                reporting: _active,
                tlsEnforcing: scoped.Count(r =>
                    dns.TryGetValue(r.Domain, out var read)
                    && read.MtaStsMode.Equals("enforce", StringComparison.OrdinalIgnoreCase)),
                rates: _rates,
                dnsRead: scoped.Count(r => dns.ContainsKey(r.Domain)));
        }
        catch (Exception)
        {
            // A chart is the one thing on this page that can be dropped
            // without misleading anybody. The rows are the page; losing the
            // picture is better than losing them to an exception.
            _series = null;
            _breakdown = null;
            _sources = [];
            _sourceCount = 0;
            _active = _inactive = 0;
            _sparks = new Dictionary<string, IReadOnlyList<DayPoint>>();
        }
    }

    private static string Css(TriageLevel level) => level switch
    {
        TriageLevel.Urgent => "urgent",
        TriageLevel.Act => "act",
        TriageLevel.Watch => "watch",
        TriageLevel.OnTrack => "ontrack",
        _ => "fine",
    };

    private static string Label(TriageLevel level) => level switch
    {
        TriageLevel.Urgent => "losing mail",
        TriageLevel.Act => "needs work",
        TriageLevel.Watch => "worth a look",
        TriageLevel.OnTrack => "rollout on track",
        _ => "fine",
    };
}
