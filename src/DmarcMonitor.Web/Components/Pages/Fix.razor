@page "/fix"
@using DmarcMonitor.Core.Remediation
@using DmarcMonitor.Core.Rollout
@using DmarcMonitor.Web.Data
@using DmarcMonitor.Web.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject RemediationUiService Fixes
@inject ReportStoreConnection Db
@inject AuthenticationStateProvider Auth
@inject OrgContext Org
@rendermode InteractiveServer

<PageTitle>Fix — DMARC Monitor</PageTitle>

<header class="page-head">
    <div>
        <h1>Fix</h1>
        <p class="sub">What the product would change in each customer's DNS, and the button that does it.
           Nothing is written without a reason, and every write is recorded and appears on the client's
           report under "what we did".</p>
    </div>
</header>

@if (!Db.Exists)
{
    <div class="empty">
        <h2>No database yet</h2>
        <p>Nothing has been imported, so there is nothing to fix.</p>
    </div>
}
else if (!_loaded)
{
    <p class="muted">Reading what each domain publishes…</p>
}
else if (_error is not null)
{
    <div class="empty">
        <h2>Could not plan</h2>
        <p>@_error</p>
    </div>
}
else
{
    @if (_message is not null)
    {
        <section class="callout @(_messageIsError ? "urgent" : "fine")">
            <h2>@_message</h2>
        </section>
    }

    @if (_domains.Count > 0 && !_domains.Values.Any(d => d.CanApply))
    {
        <section class="callout act">
            <h2>No DNS provider is configured, so fixes can be shown but not applied</h2>
            <p>Add one under Settings. Until then each fix below says what to publish by hand.</p>
        </section>
    }

    @if (_pending > 0)
    {
        <p class="muted">Reading DNS for @_pending more domain(s)…</p>
    }

    @* There is an empty state for a missing database file but there was none
       for a database with no domains in it, so a fresh install saw the heading
       and then "Nothing has been applied yet" with nothing in between - the
       one page in the application without an answer to "there is nothing
       here yet". *@
    @if (_pending == 0 && _rows.Count == 0)
    {
        <div class="empty">
            <h2>Nothing to fix yet</h2>
            <p>Domains appear here as reports arrive for them. Once there is something to
               judge, this page shows what it would change in each customer's DNS and the
               button that does it.</p>
            <p><a href="import">Import a folder of reports</a> to get started, or set up the
               mailbox ingest so they arrive on their own.</p>
        </div>
    }

    @* A book of eighteen domains was eighteen equal-weight sections stacked
       down the page, every one of them open, most with nothing to do. The
       counts say what the page is for before any of it is read, and the
       filter means it opens on the work. *@
    @if (_rows.Count > 0)
    {
        <section class="worklist">
            <div class="counts">
                <span class="count act"><strong>@Ready</strong> ready to apply</span>
                <span class="count watch"><strong>@Manual</strong> to publish by hand</span>
                <span class="count urgent"><strong>@Blocked</strong> blocked</span>
                <span class="count"><strong>@Settled</strong> nothing to do</span>
            </div>
            <label class="filter">
                <input type="checkbox" @bind="_onlyWork" />
                Only domains with something to do
            </label>
        </section>
    }

    @foreach (var row in Shown)
    {
        var d = _domains.GetValueOrDefault(row.Domain);

        <section class="domain-fix">
            <h2>
                <a href="/domains/@row.Domain">@row.Domain</a>
                <span class="muted"> — @row.ClientName</span>
                @if (d is { CurrentPolicy.Length: > 0 })
                {
                    <code class="pill">p=@d.CurrentPolicy</code>
                }
                @if (d is not null)
                {
                    <span class="muted provider">via @d.ProviderName</span>
                }
            </h2>

            @if (d is null)
            {
                @* Listed at once and filled in as each answer arrives. Asking
                   DNS about ten domains takes long enough that a page showing
                   nothing until the last one reads as broken. *@
                <p class="muted">Checking what it publishes…</p>
            }
            else if (d.Published.LookupFailed)
            {
                <p class="bad">DNS could not be read for this domain. Nothing is planned from a failed read.</p>
            }
            else
            {
                @if (d.Triage is { } t && t.Headline.Length > 0)
                {
                    <p class="sub">The reports say: @t.Headline</p>
                }

                @if (d.ProviderError is not null)
                {
                    <p class="bad">@d.ProviderError</p>
                }

                @if (Silent(d))
                {
                    @* No reports means no way to see what enforcing would cost,
                       so the control that enforces is not offered. Fixing the
                       collection comes first, and the headline above says so. *@
                }
                else if (d.ReadyFor is { } next && next != d.CurrentPolicy && !d.Plans.Any(p => p.Type == ChangeType.DmarcPolicy && p.Summary.Contains("Move ", StringComparison.Ordinal)))
                {
                    <div class="form-row">
                        <button class="primary" @onclick="() => PlanPolicyAsync(d.Domain, next)">Plan the move to p=@next</button>
                    </div>
                }
                else if (d.CurrentPolicy is "none" or "quarantine" && !d.Plans.Any(p => p.Summary.Contains("Move ", StringComparison.Ordinal)))
                {
                    <div class="form-row">
                        @* Read with a default and written explicitly. @bind to a
                           dictionary indexer reads the key before anything has
                           written it, which throws during render and takes the
                           whole circuit down: the page then sits there looking
                           like it is still loading, forever. *@
                        <select @bind:get="Choice(d.Domain)" @bind:set="v => _policyChoice[d.Domain] = v ?? string.Empty">
                            <option value="">Move to…</option>
                            @if (d.CurrentPolicy == "none") { <option value="quarantine">p=quarantine</option> }
                            <option value="reject">p=reject</option>
                        </select>
                        <button class="primary" disabled="@(Choice(d.Domain).Length == 0)"
                                @onclick="() => PlanPolicyAsync(d.Domain, Choice(d.Domain))">Plan it</button>
                    </div>
                }

                @if (d.Plans.Count == 0 && d.TransportRecords.Count == 0)
                {
                    <p class="muted">Nothing to fix.</p>
                }

                @if (d.Plans.Count > 0)
                {
                    <p class="group-heading">Changes this product can make</p>
                }

                @foreach (var plan in d.Plans)
                {
                    var key = Key(plan);
                    <div class="plan @(plan.IsSafe ? "" : "refused")">
                        <p class="plan-summary">
                            @if (!plan.IsSafe)
                            {
                                <strong>Refused.</strong>
                            }
                            @(plan.IsSafe ? plan.Summary : plan.Blockers[0])
                        </p>
                        @if (plan.IsSafe && !plan.IsNoop)
                        {
                            <table class="triage diff">
                                <tbody>
                                    <tr><td>Record</td><td><code>@plan.RecordName</code> @plan.RecordType</td></tr>
                                    <tr><td>Before</td><td><code>@(plan.CurrentValue.Length == 0 ? "(nothing)" : plan.CurrentValue)</code></td></tr>
                                    <tr><td>After</td><td><code>@plan.ProposedValue</code></td></tr>
                                </tbody>
                            </table>
                            @foreach (var w in plan.Warnings)
                            {
                                <p class="sub">Note: @w</p>
                            }
                            @if (d.CanApply)
                            {
                                <div class="form-row">
                                    <input class="wide" placeholder="Reason, written for the customer's report"
                                           @bind:get="Reason(key)" @bind:set="v => _reasons[key] = v ?? string.Empty"
                                           @bind:event="oninput" />
                                    <button class="primary" disabled="@(_busy || Reason(key).Trim().Length == 0)"
                                            @onclick="() => ApplyAsync(plan)">Apply</button>
                                </div>
                            }
                            else
                            {
                                <p class="sub">No DNS API for this zone. Publish it by hand, then it will show as done next time this page loads.</p>
                            }
                        }
                    </div>
                }

                @* Transport security, as records rather than as advice.
                   A domain with no MTA-STS has nothing to CHANGE, so the
                   planner above says nothing about it - which left an
                   operator told "no MTA-STS policy" with no way to find out
                   what to publish. These are the records themselves. *@
                @if (d.TransportRecords.Count > 0)
                {
                    <details class="plan">
                        <summary>Publish by hand — @d.TransportRecords.Count transport-security record(s)</summary>

                        @if (d.PolicyHostUnknown && d.TransportRecords.Any(r => r.Type == "CNAME"))
                        {
                            <p class="bad">
                                Nobody has set <code>MtaSts:PolicyHost</code>, so the CNAME target below is a
                                placeholder. Set it to the hostname this app is reachable on, or the policy
                                will point somewhere senders cannot fetch it.
                            </p>
                        }

                        <table class="triage diff">
                            <tbody>
                                @foreach (var record in d.TransportRecords)
                                {
                                    <tr>
                                        <td><code>@record.Name</code></td>
                                        <td>
                                            <code>@record.Type</code>
                                            <code class="value">@record.Value</code>
                                            <p class="sub">@record.Why</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (d.PolicyFile.Length > 0)
                        {
                            <p class="sub">The policy file served at the end of that CNAME:</p>
                            <pre class="policy">@d.PolicyFile</pre>
                        }
                        else if (d.TransportRecords.Any(r => r.Name.StartsWith("mta-sts.", StringComparison.Ordinal)))
                        {
                            <p class="sub">
                                No policy has been created for this domain yet, so there is no version to
                                announce and the <code>_mta-sts</code> record is not shown — publishing an id
                                this app does not serve is worse than publishing nothing. Create one first:
                                <code>dmarc mta-sts set --domain @d.Domain</code>
                            </p>
                        }
                    </details>
                }
            }
        </section>
    }

    @if (_onlyWork && Settled > 0)
    {
        <p class="muted settled-note">
            @Settled domain(s) with nothing to do are hidden. Untick the filter above to see them.
        </p>
    }

    <section>
        <h2>What has been changed</h2>
        @if (_history is null || _history.Count == 0)
        {
            <p class="muted">Nothing has been applied yet.</p>
        }
        else
        {
            <table class="triage">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Domain</th>
                        <th>Change</th>
                        <th>By</th>
                        <th>State</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _history)
                    {
                        <tr>
                            <td>@c.AppliedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@c.Domain</td>
                            <td>
                                <code>@c.RecordName</code><br />
                                <span class="muted">before:</span> <code>@(c.PreviousValue ?? "(nothing)")</code><br />
                                <span class="muted">after:</span> <code>@(c.NewValue ?? "(removed)")</code><br />
                                <span class="sub">@c.Reason</span>
                            </td>
                            <td>@c.AppliedBy<br /><span class="muted">@c.Provider</span></td>
                            <td>
                                @if (c.RolledBackAt is not null)
                                {
                                    <span class="muted">rolled back @c.RolledBackAt.Value.ToString("yyyy-MM-dd"): @c.RollbackReason</span>
                                }
                                else if (c.IsPropagated)
                                {
                                    <span class="good">live</span>
                                }
                                else
                                {
                                    <span class="muted">accepted, not yet seen in DNS</span>
                                }
                            </td>
                            <td>
                                @if (c.RolledBackAt is null)
                                {
                                    <div class="form-row">
                                        <input placeholder="Why"
                                               @bind:get="RollbackReason(c.Id)"
                                               @bind:set="v => _rollbackReasons[c.Id] = v ?? string.Empty"
                                               @bind:event="oninput" />
                                        <button disabled="@(_busy || RollbackReason(c.Id).Trim().Length == 0)"
                                                @onclick="() => RollBackAsync(c.Id)">Roll back</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private IReadOnlyList<DomainTriage> _rows = [];
    private readonly Dictionary<string, DomainFixes> _domains = new(StringComparer.OrdinalIgnoreCase);
    private int _pending;
    private bool _loaded;
    private string? _tenant;
    private IReadOnlyList<AppliedChange>? _history;
    private string? _error;
    private string? _message;
    private bool _messageIsError;
    private bool _busy;

    private readonly Dictionary<string, string> _reasons = new();
    private readonly Dictionary<string, string> _rollbackReasons = new();
    private readonly Dictionary<string, string> _policyChoice = new();

    private static string Key(ChangePlan plan) => plan.RecordName + "|" + plan.ProposedValue;

    // Reading a missing key is the normal case - nothing has been typed yet -
    // so every read goes through one of these rather than an indexer.
    /// <summary>
    /// A domain whose reports have stopped. Advancing one is the change most
    /// likely to lose mail and the one there is least evidence for.
    /// </summary>
    private static bool Silent(DomainFixes d) =>
        d.Triage is null
        || d.Triage.LastReport is null
        || (DateTimeOffset.UtcNow - d.Triage.LastReport.Value).TotalDays > RolloutAssessment.SilentDays;

    private string Choice(string domain) => _policyChoice.GetValueOrDefault(domain, "");
    private string Reason(string key) => _reasons.GetValueOrDefault(key, "");
    private string RollbackReason(string changeId) => _rollbackReasons.GetValueOrDefault(changeId, "");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // DNS is read after the first paint, as on the domain page, so the
        // page appears at once and fills in rather than hanging on a lookup.
        if (!firstRender || !Db.Exists) { return; }

        await LoadAsync();
    }

    // ---- what the page is for, before any of it is read ---------------------

    /// <summary>Open on the work rather than on the whole book.</summary>
    private bool _onlyWork = true;

    /// <summary>A change this product could make now, given a provider.</summary>
    private static bool HasReadyWork(DomainFixes d) =>
        d.Plans.Any(p => p.IsSafe && !p.IsNoop);

    /// <summary>Records only a person can publish - no API, or nothing to automate.</summary>
    private static bool HasManualWork(DomainFixes d) => d.TransportRecords.Count > 0;

    /// <summary>
    /// Something is wrong that the page cannot get past on its own.
    /// </summary>
    /// <remarks>
    /// A refused plan counts. It is not a failure of the product - the refusal
    /// is the finding - but it is the thing an operator has to go and deal
    /// with, so it belongs with the work rather than with the quiet domains.
    /// </remarks>
    private static bool IsBlocked(DomainFixes d) =>
        d.Published.LookupFailed || d.ProviderError is not null || d.Plans.Any(p => !p.IsSafe);

    private static bool NeedsAttention(DomainFixes d) =>
        HasReadyWork(d) || HasManualWork(d) || IsBlocked(d);

    private int Ready => _domains.Values.Count(HasReadyWork);
    private int Manual => _domains.Values.Count(d => !HasReadyWork(d) && HasManualWork(d));
    private int Blocked => _domains.Values.Count(IsBlocked);
    private int Settled => _domains.Values.Count(d => !NeedsAttention(d));

    /// <summary>
    /// The rows to draw. A domain still being read is always shown, because
    /// hiding it would make the page appear to lose domains while it loads.
    /// </summary>
    private IEnumerable<DomainTriage> Shown =>
        !_onlyWork
            ? _rows
            : _rows.Where(r => _domains.GetValueOrDefault(r.Domain) is not { } d || NeedsAttention(d));

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            // The scope first, then the list, which is a database read and
            // instant, then the DNS for each one behind it.
            _tenant = (await Org.GetAsync()).TenantId;
            _rows = await Fixes.DomainsAsync(_tenant);
            _history = await Fixes.HistoryAsync(_tenant);
            _pending = _rows.Count;
            _loaded = true;
            await InvokeAsync(StateHasChanged);

            // A few at a time: one at a time is a minute of staring at a
            // half-filled page, and all at once is one page load opening a
            // resolver conversation per domain. Eight is measured rather than
            // picked - it is where the wall clock stops improving on a book of
            // eighteen domains, because each one is latency rather than work.
            foreach (var batch in _rows.Chunk(8))
            {
                // Off the circuit's dispatcher. Everything in here is network
                // and database work, and running it on the thread that renders
                // means the page cannot repaint while it waits - which is the
                // whole point of filling the list in as answers arrive.
                var planned = await Task.Run(
                    () => Task.WhenAll(batch.Select(r => Fixes.PlanAsync(r.Domain, r, null, _tenant))));

                foreach (var plan in planned) { _domains[plan.Domain] = plan; }
                _pending -= batch.Length;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _pending = 0;
            _loaded = true;
        }
    }

    private async Task PlanPolicyAsync(string domain, string? policy)
    {
        if (string.IsNullOrEmpty(policy) || !_domains.TryGetValue(domain, out var current)) { return; }

        _domains[domain] = await Fixes.PlanAsync(domain, current.Triage, policy, _tenant);
    }

    private async Task<string> WhoAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? Environment.UserName;
    }

    private async Task ApplyAsync(ChangePlan plan)
    {
        var reason = Reason(Key(plan)).Trim();
        if (string.IsNullOrEmpty(reason)) { return; }

        _busy = true;
        try
        {
            var outcome = await Fixes.ApplyAsync(plan, await WhoAsync(), reason);
            Set(outcome.Message, isError: !outcome.Applied);
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private async Task RollBackAsync(string changeId)
    {
        var reason = RollbackReason(changeId).Trim();
        if (string.IsNullOrEmpty(reason)) { return; }

        _busy = true;
        try
        {
            var outcome = await Fixes.RollBackAsync(changeId, await WhoAsync(), reason);
            Set(outcome.Message, isError: !outcome.Applied);
        }
        catch (Exception ex)
        {
            Set(ex.Message, isError: true);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private void Set(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }
}
