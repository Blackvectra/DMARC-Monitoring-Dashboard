@inherits LayoutComponentBase
@using DmarcMonitor.Core.Tenancy
@using DmarcMonitor.Web.Auth
@inject IConfiguration Configuration
@inject OrgContext Org
@inject NavigationManager Navigation

@*
    The shell. Three jobs beyond holding the page: say which navigation is
    daily work and which is setup, say which organization is being looked at
    and let a person who may see more than one switch, and get out of the way
    on a narrow screen.

    The nine links used to be one flat list, which made "Triage" - where every
    morning starts - look like the same kind of thing as "Updates", which is
    touched twice a year.

    The menu, theme and organization controls call plain JavaScript rather
    than carrying @@onclick. This layout has no render mode: pages are
    interactive islands inside a statically rendered shell, so a Blazor handler
    here is never wired up and does nothing when clicked. That is how the first
    version shipped, and only driving it in a real browser caught it - both
    buttons rendered perfectly and neither worked.

    White-label: the organization being looked at lends the shell its color
    and its logo. The color only ever comes from the store, which refuses
    anything but a six-digit hex, and it is checked again here because it is
    written into a style attribute.
*@

<div class="app" style="@Accent">
    @* Only shown on a narrow screen, by CSS. *@
    <button class="nav-toggle" onclick="dmarcShell.toggleNav()" aria-label="Toggle navigation">
        ☰ Menu
    </button>

    @* Tapping away from an open menu closes it, which is what every phone
       does. A button rather than a div so it is reachable without a pointer. *@
    <button class="scrim" onclick="dmarcShell.closeNav()" aria-label="Close navigation" tabindex="-1"></button>

    <nav class="sidebar">
        <div class="brand">
            @if (Logo is not null)
            {
                <img class="brand-logo" src="@Logo" alt="@(_access?.Current?.Name ?? "DMARC Monitor")" />
            }
            else
            {
                <span class="brand-mark">DM</span>
                <span class="brand-name">@(_access?.Current?.Name ?? "DMARC Monitor")</span>
            }
        </div>

        @* Which organization this is. A switcher for anybody who may see more
           than one; a plain name for everybody else, because a select with one
           option is a control that does nothing. *@
        @if (_access is { HasAccess: true })
        {
            <div class="org">
                @if (_access.CanSwitch)
                {
                    <label class="org-label" for="org-switch">Organization</label>
                    <select id="org-switch" class="org-switch" onchange="dmarcShell.switchOrg(this.value)" aria-label="Organization">
                        @if (_access.IsMaster)
                        {
                            <option value="" selected="@(_access.Current is null)">All organizations</option>
                        }
                        @foreach (var o in _access.Visible)
                        {
                            <option value="@o.Slug" selected="@(_access.Current?.Slug == o.Slug)">@o.Name</option>
                        }
                    </select>
                }
                else if (_access.Current is not null && Logo is not null)
                {
                    <p class="org-label">Organization</p>
                    <p class="org-name">@_access.Current.Name</p>
                }
                @* What this person may do here, said plainly: a viewer who
                   cannot find the Apply button should know it is not missing. *@
                <p class="org-role">@RoleLabel</p>
            </div>
        }

        @*
            Shaped like the platforms an MSP is comparing this against: the
            few things looked at daily sit at the top level, and the rest are
            folded into named groups that open when you are in them.

            Only routes that exist. A nav listing pages that are not built is
            a worse first impression than a short one, and the competitor
            navs this was modelled on are long because those products are
            older, not because the shape requires it - there is room in
            Reporting for failure and TLS reports when they are written.

            <details> rather than a toggle: it collapses with no script, which
            matters because this application is installed on machines that
            cannot reach a CDN, and it keeps working if the circuit drops.
        *@
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink class="nav-item" href="domains">Domain health</NavLink>
        <NavLink class="nav-item" href="sources">Sending sources</NavLink>
        <NavLink class="nav-item" href="fix">Fix</NavLink>

        <details class="nav-fold" open="@In("reports", "import")">
            <summary class="nav-group">Reporting</summary>
            <NavLink class="nav-item" href="reports">Client reports</NavLink>
            @if (_access is not { RestrictedClient: not null })
            {
                <NavLink class="nav-item" href="import">Import</NavLink>
            }
        </details>

        @* What you set once, or when a client is onboarded. A customer's own
           login gets none of it; there is nothing there for them. *@
        @if (_access is not { RestrictedClient: not null })
        {
            <details class="nav-fold" open="@In("clients", "settings", "updates")">
                <summary class="nav-group">Settings</summary>
                <NavLink class="nav-item" href="clients">Clients</NavLink>
                <NavLink class="nav-item" href="settings">Configuration</NavLink>
                <NavLink class="nav-item" href="updates">Updates</NavLink>
            </details>
        }

        <div class="sidebar-foot">
            <AuthorizeView>
                <Authorized>
                    <div class="who">@context.User.Identity?.Name</div>
                    @if (EntraConfigured)
                    {
                        <a class="signout" href="MicrosoftIdentity/Account/SignOut">Sign out</a>
                    }
                </Authorized>
            </AuthorizeView>

            @* Ships the light-theme wording; the script corrects it on load
               and after each enhanced navigation, since the server cannot
               know which theme this browser stored. *@
            <button class="theme-toggle" onclick="dmarcTheme.toggle()">☾ Dark</button>
        </div>
    </nav>

    <main>
        @if (!EntraConfigured)
        {
            @* Said on every page, not just at startup. An operator who cannot
               tell whether sign-in is on has no way to notice that it is not. *@
            <div class="banner-warn">
                <strong>Local trial mode — no sign-in.</strong>
                Only this machine can reach it. Configure <code>AzureAd</code> in
                <code>appsettings.json</code> to turn on Microsoft sign-in.
            </div>
        }

        @if (_access is { HasAccess: false })
        {
            @* Signed in, and in no organization's group. The page is withheld
               rather than rendered empty, and it says what would change that,
               because "no domains" would read as a product with nothing in it
               rather than a person with nothing granted. *@
            <div class="empty">
                <h2>No organization</h2>
                <p>You are signed in, but you are not in the security group of any organization here, so there
                   is nothing you can see.</p>
                <p class="muted">Ask whoever runs this to add you to an organization's group in Microsoft Entra,
                   or to the master group named in <code>Auth:MasterGroupId</code>. Sign out and back in once
                   they have.</p>
            </div>
        }
        else
        {
            @Body
        }
    </main>
</div>

@code {
    private OrganizationAccess? _access;

    /// <summary>
    /// Whether the current page is one of these, so its group opens.
    /// </summary>
    /// <remarks>
    /// A group that stays shut while you are inside it makes the sidebar
    /// disagree with the page, and the person hunting for where they are is
    /// the person least able to afford that.
    /// </remarks>
    private bool In(params string[] routes)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        return routes.Any(r => path.Equals(r, StringComparison.OrdinalIgnoreCase)
                            || path.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase));
    }

    private bool EntraConfigured => DmarcMonitor.Web.Auth.AuthSetup.IsEntraConfigured(Configuration);

    private string? Logo =>
        _access?.Current?.Brand.Logo is { } logo && OrganizationBrand.IsValidLogo(logo) ? logo : null;

    private string Accent =>
        _access?.Current?.Brand.PrimaryColor is { } c && OrganizationBrand.IsValidColor(c) ? $"--accent: {c};" : "";

    private string RoleLabel => _access?.CurrentRole switch
    {
        OrganizationRole.Master => "master: every organization",
        OrganizationRole.Admin => "admin",
        OrganizationRole.Engineer => "engineer",
        // Says what is missing rather than only what is held: a tech who
        // cannot find the policy buttons should learn from the sidebar that
        // they are withheld, not conclude the page is broken.
        OrganizationRole.Tech => "tech, no policy changes",
        OrganizationRole.Viewer when _access.RestrictedClient is not null => "your organization's view, read only",
        OrganizationRole.Viewer => "viewer, read only",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _access = await Org.GetAsync();
        }
        catch (Exception)
        {
            // No database yet, or one that cannot be read. The pages say so
            // themselves; the shell must still draw so they can.
            _access = null;
        }
    }
}
