<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Argument parsing decides whether DNS gets written. It is tested. -->
    <InternalsVisibleTo Include="DmarcMonitor.Cli.Tests" />
    <ProjectReference Include="..\DmarcMonitor.Core\DmarcMonitor.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      The command is "dmarc", so the binary is called dmarc. Every example in
      the help text and the README says "dmarc import ...", and shipping a
      DmarcMonitor.Cli.exe instead makes all of them wrong on the one machine
      where they matter.
    -->
    <AssemblyName>dmarc</AssemblyName>
    <RootNamespace>DmarcMonitor.Cli</RootNamespace>
  </PropertyGroup>

</Project>
