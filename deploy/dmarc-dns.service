# One DNS reading of every domain in the book. Started by dmarc-dns.timer;
# runnable by hand with
#   sudo systemctl start dmarc-dns
#
# This is what fills the SPF, DKIM and DMARC columns on the domains page.
# Without it those columns say only that nothing has been read, which is the
# truth but not a useful one.
#
# Needs no configuration at all: no mailbox, no certificate, no credential. It
# reads public DNS and writes to the database. That is also why it is a
# separate unit from dmarc-ingest rather than a step inside it - the collector
# holds the certificate that can read a mailbox, and this holds nothing worth
# holding.

[Unit]
Description=Read each domain's published DNS records
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dmarc
ExecStart=/usr/local/bin/dmarc check --all --save --db /opt/dmarc/data/dmarc.db

# 'check' exits 1 when it finds a breaking fault in somebody's records, which
# is what makes it useful in a pipeline and useless as a service: systemd
# would mark the unit failed for doing its job and finding a real problem.
# The findings are in the journal either way; what matters here is whether the
# run itself worked.
SuccessExitStatus=0 1

# The same reason as dmarc-ingest: the self-contained binary unpacks its
# native SQLite library on first run and needs somewhere writable to do it.
# Left unset it uses the home directory, which the sandbox below hides, and
# the command dies with exit 159 before printing anything.
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/opt/dmarc/data/.net

# Reads public DNS and writes one database. It needs nothing else, and unlike
# the collector it holds no secret, so it gets the same sandbox with nothing
# added to it.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/dmarc/data
